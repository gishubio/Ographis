{
  "format": "ographis/1",
  "name": "Weather and light in 3D",
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 40,
      "y": 60,
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid",
        "within": "rectangle",
        "min_x": "418100",
        "min_y": "6472350",
        "max_x": "418500",
        "max_y": "6472700"
      }
    },
    {
      "id": "town",
      "type": "Reader",
      "x": 40,
      "y": 200,
      "params": {
        "path": "town.geojson"
      }
    },
    {
      "id": "make",
      "type": "BuildingMaker",
      "x": 300,
      "y": 200,
      "params": {}
    },
    {
      "id": "names",
      "type": "Reader",
      "x": 40,
      "y": 420,
      "comment": "Places to name in the pictures",
      "params": {
        "path": "village_names.geojson"
      }
    },
    {
      "id": "trees",
      "type": "Reader",
      "x": 40,
      "y": 520,
      "comment": "Trees, with their kind",
      "params": {
        "path": "village_trees.geojson"
      }
    },
    {
      "id": "lamps",
      "type": "Reader",
      "x": 40,
      "y": 620,
      "comment": "Street lamps, for the night",
      "params": {
        "path": "lamps.geojson"
      }
    },
    {
      "id": "winter",
      "type": "SceneRenderer",
      "x": 560,
      "y": 60,
      "comment": "Falling snow, snow on the roofs and the ground, bare trees",
      "params": {
        "width": "1200",
        "height": "750",
        "quality": "16",
        "background": "sky",
        "tree_kind_by": "kind",
        "tree_height": "9",
        "elevation": "12",
        "zoom": "170",
        "names_by": "name",
        "snow_fall": "35",
        "snow_cover": "85",
        "season": "winter"
      }
    },
    {
      "id": "png_winter",
      "type": "Writer",
      "x": 860,
      "y": 60,
      "params": {
        "path": "out/weather_winter.png"
      }
    },
    {
      "id": "night",
      "type": "SceneRenderer",
      "x": 560,
      "y": 200,
