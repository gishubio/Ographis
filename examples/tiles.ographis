{
  "format": "ographis/1",
  "name": "Three houses as 3D Tiles",
  "nodes": [
    { "id": "tiles", "type": "Reader", "name": "Houses (3D Tiles)", "x": 20, "y": 20,
      "comment": "A tileset of three houses, as Batched 3D Models with a name and a year for each. 3D Tiles have heights above the ellipsoid: -32 m brings them to RH 2000",
      "params": { "path": "tiles/tileset.json", "tiles_detail": "finest", "tiles_crs": "EPSG:3006", "tiles_dz": "-32" } },
    { "id": "dem", "type": "Reader", "name": "Terrain", "x": 20, "y": 220, "params": { "path": "terrain.tif", "raster_as": "grid" } },
    { "id": "view", "type": "Viewer", "name": "Look at both", "x": 300, "y": 120, "params": {} },
    { "id": "scene", "type": "SceneRenderer", "name": "Afternoon", "x": 300, "y": 260,
      "params": { "width": "1200", "height": "750", "background": "sky", "sun": "date", "date": "2026-06-21", "time": "17:00", "view_azimuth": "200", "elevation": "25", "zoom": "80" } },
    { "id": "png", "type": "Writer", "name": "Picture", "x": 560, "y": 260, "params": { "path": "out/tiles_houses.png" } },
    { "id": "list", "type": "Writer", "name": "The houses", "x": 300, "y": 20, "params": { "path": "out/tiles_houses.xlsx" } }
  ],
  "edges": [
    { "from": ["tiles", "Output"], "to": ["view", "Input"] },
    { "from": ["dem", "Output"], "to": ["view", "Input"] },
    { "from": ["tiles", "Output"], "to": ["scene", "Models"] },
    { "from": ["dem", "Output"], "to": ["scene", "Terrain"] },
    { "from": ["scene", "Image"], "to": ["png", "Input"] },
    { "from": ["tiles", "Output"], "to": ["list", "Input"] }
  ]
}
