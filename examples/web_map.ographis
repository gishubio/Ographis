{
  "format": "ographis/1",
  "name": "Web map",
  "nodes": [
    {
      "id": "areas",
      "type": "Reader",
      "name": "Subregions",
      "x": 20,
      "y": 20,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Input: the subregions of Skaraborg"
    },
    {
      "id": "routes",
      "type": "Reader",
      "name": "Routes",
      "x": 20,
      "y": 140,
      "params": {
        "path": "routes.shp"
      },
      "comment": "Input: the routes"
    },
    {
      "id": "towns",
      "type": "Reader",
      "name": "Towns",
      "x": 20,
      "y": 260,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Input: the towns, in degrees"
    },
    {
      "id": "web",
      "type": "WebMapWriter",
      "name": "Web map",
      "x": 300,
      "y": 20,
      "comment": "Web map output: open out/web_map/index.html in a browser. Click a town to see its attributes, and turn layers on and off in the legend.",
      "params": {
        "path": "out/web_map",
        "format": "webmap",
        "title": "Skaraborg",
        "library": "leaflet",
        "basemap": "carto_light",
        "layers": [
          {
            "from": "towns:Output",
            "fill": "#000000",
            "stroke": "#ffffff",
            "width": 1.5,
            "size": 9,
            "name": "Towns",
            "label": "name"
          },
          {
            "from": "routes:Output",
            "fill": "none",
            "stroke": "#b2182b",
            "width": 2.5,
            "size": 6,
            "name": "Routes"
          },
          {
            "from": "areas:Output",
            "fill": "#cfe3f2",
            "stroke": "#4a7fb0",
            "width": 1.5,
            "size": 6,
            "name": "Subregions"
          }
        ]
      }
    },
    {
      "id": "gl",
      "type": "WebMapWriter",
      "name": "Web map with MapLibre",
      "x": 300,
      "y": 200,
      "comment": "Web map output: the same with MapLibre GL, drawn by the graphics card, in out/web_map_gl",
      "params": {
        "path": "out/web_map_gl",
        "format": "webmap",
        "title": "Skaraborg",
        "library": "maplibre",
        "basemap": "carto_light",
        "layers": [
          {
            "from": "towns:Output",
            "fill": "#000000",
            "stroke": "#ffffff",
            "width": 1.5,
            "size": 9,
            "name": "Towns",
            "label": "name"
          },
          {
            "from": "routes:Output",
            "fill": "none",
            "stroke": "#b2182b",
            "width": 2.5,
            "size": 6,
            "name": "Routes"
          },
          {
            "from": "areas:Output",
            "fill": "#cfe3f2",
            "stroke": "#4a7fb0",
            "width": 1.5,
            "size": 6,
            "name": "Subregions"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "web",
        "Layers"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "web",
        "Layers"
      ]
    },
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "web",
        "Layers"
      ]
    },
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "gl",
        "Layers"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "gl",
        "Layers"
      ]
    },
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "gl",
        "Layers"
      ]
    }
  ]
}