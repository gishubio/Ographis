{
  "format": "ographis/1",
  "name": "A map of the subregions",
  "nodes": [
    {
      "id": "areas",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "routes",
      "type": "Reader",
      "x": 20,
      "y": 160,
      "params": {
        "path": "routes.shp"
      },
      "comment": "Routes"
    },
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 300,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "map",
      "type": "MapRenderer",
      "x": 300,
      "y": 140,
      "comment": "Map of the subregions. The top row in the list of layers is drawn on top",
      "params": {
        "width": "1600",
        "crs": "EPSG:3006",
        "layers": [
          {
            "from": "towns:Output",
            "fill": "#000000",
            "stroke": "#ffffff",
            "width": 1.5,
            "size": 9,
            "name": "Towns"
          },
          {
            "from": "routes:Output",
            "fill": "none",
            "stroke": "#b2182b",
            "width": 2.5,
            "size": 6,
            "name": "Routes"
          },
          {
            "from": "areas:Output",
            "fill": "#cfe3f2",
            "stroke": "#4a7fb0",
            "width": 1.5,
            "size": 6,
            "name": "Subregions"
          }
        ]
      }
    },
    {
      "id": "png",
      "type": "Writer",
      "x": 560,
      "y": 60,
      "params": {
        "path": "out/map.png"
      },
      "comment": "Map as PNG"
    },
    {
      "id": "tif",
      "type": "Writer",
      "x": 560,
      "y": 200,
      "params": {
        "path": "out/map.tif"
      },
      "comment": "Map as GeoTIFF"
    },
    {
      "id": "pdf",
      "type": "Writer",
      "x": 560,
      "y": 340,
      "params": {
        "path": "out/map.pdf",
        "pdf_title": "Subregions, routes and towns – Skaraborg, Västra Götaland"
      },
      "comment": "Map as PDF"
    }
  ],
  "edges": [
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "png",
        "Input"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "tif",
        "Input"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "pdf",
        "Input"
      ]
    }
  ]
}
