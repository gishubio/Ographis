{
  "format": "ographis/1",
  "name": "A village from OpenStreetMap, as a PDF with layers",
  "nodes": [
    {
      "id": "areas",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "comment": "Areas. A made-up village in OpenStreetMap's own format",
      "params": {
        "path": "village.osm.pbf",
        "layer": "multipolygons"
      }
    },
    {
      "id": "roads",
      "type": "Reader",
      "x": 20,
      "y": 200,
      "params": {
        "path": "village.osm.pbf",
        "layer": "lines"
      },
      "comment": "Roads"
    },
    {
      "id": "places",
      "type": "Reader",
      "x": 20,
      "y": 360,
      "params": {
        "path": "village.osm.pbf",
        "layer": "points"
      },
      "comment": "Places"
    },
    {
      "id": "kind",
      "type": "Tester",
      "x": 260,
      "y": 20,
      "params": {
        "test": "building IS NOT NULL"
      },
      "comment": "Buildings"
    },
    {
      "id": "check",
      "type": "AttributeValidator",
      "x": 260,
      "y": 360,
      "params": {
        "checks": [
          {
            "attribute": "name",
            "required": true
          },
          {
            "attribute": "amenity",
            "values": "cafe, school, place_of_worship"
          }
        ]
      },
      "comment": "Every place has a name"
    },
    {
      "id": "xy",
      "type": "CoordinateExtractor",
      "x": 500,
      "y": 360,
      "params": {
        "decimals": "6",
        "x_name": "lon",
        "y_name": "lat"
      },
      "comment": "Coordinates"
    },
    {
      "id": "list",
      "type": "Writer",
      "x": 740,
      "y": 440,
      "params": {
        "path": "out/places.xlsx"
      },
      "comment": "Places with coordinates"
    },
    {
      "id": "pdf",
      "type": "LayeredPdfWriter",
      "x": 740,
      "y": 160,
      "params": {
        "path": "out/village.pdf",
        "crs": "EPSG:3006",
        "pdf_title": "The village – from OpenStreetMap",
        "pdf_title_align": "center",
        "layers": [
          {
            "from": "xy:Output",
            "fill": "#d7301f",
            "stroke": "#ffffff",
            "width": 1.5,
            "size": 10,
            "name": "Coordinates"
          },
          {
            "from": "check:Failed",
            "show": false,
            "fill": "#000000",
            "stroke": "none",
            "width": 1,
            "size": 10,
            "name": "Every place has a name"
          },
          {
            "from": "roads:Output",
            "fill": "none",
            "stroke": "#636363",
            "width": 3,
            "size": 6,
            "name": "Roads"
          },
          {
            "from": "kind:Passed",
            "fill": "#bdbdbd",
            "stroke": "#636363",
            "width": 1,
            "size": 6,
            "name": "Buildings"
          },
          {
            "from": "kind:Failed",
            "fill": "#c7e9c0",
            "stroke": "#41ab5d",
            "width": 1,
            "size": 6,
            "name": "Buildings"
          }
        ]
      },
      "comment": "Village as PDF"
    }
  ],
  "edges": [
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "kind",
        "Input"
      ]
    },
    {
      "from": [
        "places",
        "Output"
      ],
      "to": [
        "check",
        "Input"
      ]
    },
    {
      "from": [
        "check",
        "Passed"
      ],
      "to": [
        "xy",
        "Input"
      ]
    },
    {
      "from": [
        "xy",
        "Output"
      ],
      "to": [
        "list",
        "Input"
      ]
    },
    {
      "from": [
        "kind",
        "Failed"
      ],
      "to": [
        "pdf",
        "Layers"
      ]
    },
    {
      "from": [
        "kind",
        "Passed"
      ],
      "to": [
        "pdf",
        "Layers"
      ]
    },
    {
      "from": [
        "roads",
        "Output"
      ],
      "to": [
        "pdf",
        "Layers"
      ]
    },
    {
      "from": [
        "check",
        "Failed"
      ],
      "to": [
        "pdf",
        "Layers"
      ]
    },
    {
      "from": [
        "xy",
        "Output"
      ],
      "to": [
        "pdf",
        "Layers"
      ]
    }
  ]
}
