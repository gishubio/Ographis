{
  "format": "ographis/1",
  "name": "The village through the year",
  "description": "The made-up village in 3D five times: in spring with blossom, on a midsummer evening, on a misty autumn morning, in falling snow and on a winter night under the northern lights, each picture a slide of a deck, titled by what it shows, and each also as PNG.",
  "variables": [],
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 40,
      "y": 40,
      "comment": "",
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid",
        "within": "rectangle",
        "min_x": "418100",
        "min_y": "6472350",
        "max_x": "418500",
        "max_y": "6472700"
      }
    },
    {
      "id": "town",
      "type": "Reader",
      "x": 310,
      "y": 40,
      "comment": "",
