{
  "format": "ographis/1",
  "name": "Nearest route, hexagons and overlay",
  "nodes": [
    { "id": "towns", "type": "Reader", "name": "Towns", "x": 20, "y": 20, "params": { "path": "towns.csv", "crs": "EPSG:4326" } },
    { "id": "routes", "type": "Reader", "name": "Routes", "x": 20, "y": 180, "params": { "path": "routes.shp" } },
    { "id": "areas", "type": "Reader", "name": "Subregions", "x": 20, "y": 340, "params": { "path": "subregions.gpkg" } },
    { "id": "towns_tm", "type": "Reprojector", "name": "Towns to SWEREF", "x": 240, "y": 20, "params": { "crs": "EPSG:3006" } },
    { "id": "routes_tm", "type": "Reprojector", "name": "Routes to SWEREF", "x": 240, "y": 180, "params": { "crs": "EPSG:3006" } },
    { "id": "areas_tm", "type": "Reprojector", "name": "Subregions to SWEREF", "x": 240, "y": 340, "params": { "crs": "EPSG:3006" } },
    { "id": "near", "type": "NeighborFinder", "name": "Nearest route", "x": 480, "y": 20, "comment": "How far each town is from the nearest route, and which route it is", "params": { "prefix": "route_" } },
    { "id": "split", "type": "LineSplitter", "name": "Split routes at crossings", "x": 480, "y": 180, "params": { "at": "crossings", "part": "part" } },
    { "id": "short", "type": "ValueMapper", "name": "Short names", "x": 700, "y": 340, "params": { "attribute": "subregion", "result": "short", "map": [["Skaraborg", "SKB"], ["Sjuhärad", "SJH"], ["Fyrbodal", "FYB"], ["Göteborgsregionen", "GR"]], "otherwise": "keep" } },
    { "id": "grid", "type": "GridCreator", "name": "Hexagons of 10 km", "x": 480, "y": 340, "params": { "shape": "hexagon", "size": "10000" } },
    { "id": "count", "type": "PointCounter", "name": "Towns per hexagon", "x": 700, "y": 460, "params": { "name": "towns" } },
    { "id": "buffer", "type": "Bufferer", "name": "5 km from a route", "x": 700, "y": 180, "params": { "distance": "5000" } },
    { "id": "dissolve", "type": "Dissolver", "name": "One zone", "x": 920, "y": 180, "params": {} },
    { "id": "overlay", "type": "AreaOnAreaOverlayer", "name": "Zone in each subregion", "x": 1140, "y": 260, "params": {} },
    { "id": "out_near", "type": "Writer", "name": "Towns with nearest route", "x": 700, "y": 20, "params": { "path": "out/towns_nearest_route.gpkg" } },
    { "id": "out_split", "type": "Writer", "name": "Route parts", "x": 700, "y": 100, "params": { "path": "out/route_parts.gpkg" } },
    { "id": "out_grid", "type": "Writer", "name": "Hexagons", "x": 920, "y": 460, "params": { "path": "out/hexagons.gpkg" } },
    { "id": "out_overlay", "type": "Writer", "name": "Zone per subregion", "x": 1380, "y": 260, "params": { "path": "out/zone_per_subregion.gpkg" } }
  ],
  "edges": [
    { "from": ["towns", "Output"], "to": ["towns_tm", "Input"] },
    { "from": ["routes", "Output"], "to": ["routes_tm", "Input"] },
    { "from": ["areas", "Output"], "to": ["areas_tm", "Input"] },
    { "from": ["towns_tm", "Reprojected"], "to": ["near", "Base"] },
    { "from": ["routes_tm", "Reprojected"], "to": ["near", "Candidates"] },
    { "from": ["near", "Matched"], "to": ["out_near", "Input"] },
    { "from": ["routes_tm", "Reprojected"], "to": ["split", "Lines"] },
    { "from": ["split", "Lines"], "to": ["out_split", "Input"] },
    { "from": ["areas_tm", "Reprojected"], "to": ["short", "Input"] },
    { "from": ["areas_tm", "Reprojected"], "to": ["grid", "Extent"] },
    { "from": ["grid", "Grid"], "to": ["count", "Polygons"] },
    { "from": ["towns_tm", "Reprojected"], "to": ["count", "Points"] },
    { "from": ["count", "Polygons"], "to": ["out_grid", "Input"] },
    { "from": ["routes_tm", "Reprojected"], "to": ["buffer", "Input"] },
    { "from": ["buffer", "Buffered"], "to": ["dissolve", "Input"] },
    { "from": ["dissolve", "Dissolved"], "to": ["overlay", "Overlay"] },
    { "from": ["short", "Output"], "to": ["overlay", "Areas"] },
    { "from": ["overlay", "Both"], "to": ["out_overlay", "Input"] }
  ]
}
