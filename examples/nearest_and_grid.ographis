{
  "format": "ographis/1",
  "name": "Nearest route, hexagons and overlay",
  "nodes": [
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "routes",
      "type": "Reader",
      "x": 20,
      "y": 180,
      "params": {
        "path": "routes.shp"
      },
      "comment": "Routes"
    },
    {
      "id": "areas",
      "type": "Reader",
      "x": 20,
      "y": 340,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "towns_tm",
      "type": "Reprojector",
      "x": 240,
      "y": 20,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Towns to SWEREF"
    },
    {
      "id": "routes_tm",
      "type": "Reprojector",
      "x": 240,
      "y": 180,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Routes to SWEREF"
    },
    {
      "id": "areas_tm",
      "type": "Reprojector",
      "x": 240,
      "y": 340,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Subregions to SWEREF"
    },
    {
      "id": "near",
      "type": "NeighborFinder",
      "x": 480,
      "y": 20,
      "comment": "Nearest route. How far each town is from the nearest route, and which route it is",
      "params": {
        "prefix": "route_"
      }
    },
    {
      "id": "split",
      "type": "LineSplitter",
      "x": 480,
      "y": 180,
      "params": {
        "at": "crossings",
        "part": "part"
      },
      "comment": "Split routes at crossings"
    },
    {
      "id": "short",
      "type": "ValueMapper",
      "x": 700,
      "y": 340,
      "params": {
        "attribute": "subregion",
        "result": "short",
        "map": [
          [
            "Skaraborg",
            "SKB"
          ],
          [
            "Sjuhärad",
            "SJH"
          ],
          [
            "Fyrbodal",
            "FYB"
          ],
          [
            "Göteborgsregionen",
            "GR"
          ]
        ],
        "otherwise": "keep"
      },
      "comment": "Short names"
    },
    {
      "id": "grid",
      "type": "GridCreator",
      "x": 480,
      "y": 340,
      "params": {
        "shape": "hexagon",
        "size": "10000"
      },
      "comment": "Hexagons of 10 km"
    },
    {
      "id": "count",
      "type": "PointCounter",
      "x": 700,
      "y": 460,
      "params": {
        "name": "towns"
      },
      "comment": "Towns per hexagon"
    },
    {
      "id": "buffer",
      "type": "Bufferer",
      "x": 700,
      "y": 180,
      "params": {
        "distance": "5000"
      },
      "comment": "5 km from a route"
    },
    {
      "id": "dissolve",
      "type": "Dissolver",
      "x": 920,
      "y": 180,
      "params": {},
      "comment": "One zone"
    },
    {
      "id": "overlay",
      "type": "AreaOnAreaOverlayer",
      "x": 1140,
      "y": 260,
      "params": {},
      "comment": "Zone in each subregion"
    },
    {
      "id": "out_near",
      "type": "Writer",
      "x": 700,
      "y": 20,
      "params": {
        "path": "out/towns_nearest_route.gpkg"
      },
      "comment": "Towns with nearest route"
    },
    {
      "id": "out_split",
      "type": "Writer",
      "x": 700,
      "y": 100,
      "params": {
        "path": "out/route_parts.gpkg"
      },
      "comment": "Route parts"
    },
    {
      "id": "out_grid",
      "type": "Writer",
      "x": 920,
      "y": 460,
      "params": {
        "path": "out/hexagons.gpkg"
      },
      "comment": "Hexagons"
    },
    {
      "id": "out_overlay",
      "type": "Writer",
      "x": 1380,
      "y": 260,
      "params": {
        "path": "out/zone_per_subregion.gpkg"
      },
      "comment": "Zone per subregion"
    }
  ],
  "edges": [
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "towns_tm",
        "Input"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "routes_tm",
        "Input"
      ]
    },
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "areas_tm",
        "Input"
      ]
    },
    {
      "from": [
        "towns_tm",
        "Reprojected"
      ],
      "to": [
        "near",
        "Base"
      ]
    },
    {
      "from": [
        "routes_tm",
        "Reprojected"
      ],
      "to": [
        "near",
        "Candidates"
      ]
    },
    {
      "from": [
        "near",
        "Matched"
      ],
      "to": [
        "out_near",
        "Input"
      ]
    },
    {
      "from": [
        "routes_tm",
        "Reprojected"
      ],
      "to": [
        "split",
        "Lines"
      ]
    },
    {
      "from": [
        "split",
        "Lines"
      ],
      "to": [
        "out_split",
        "Input"
      ]
    },
    {
      "from": [
        "areas_tm",
        "Reprojected"
      ],
      "to": [
        "short",
        "Input"
      ]
    },
    {
      "from": [
        "areas_tm",
        "Reprojected"
      ],
      "to": [
        "grid",
        "Extent"
      ]
    },
    {
      "from": [
        "grid",
        "Grid"
      ],
      "to": [
        "count",
        "Polygons"
      ]
    },
    {
      "from": [
        "towns_tm",
        "Reprojected"
      ],
      "to": [
        "count",
        "Points"
      ]
    },
    {
      "from": [
        "count",
        "Polygons"
      ],
      "to": [
        "out_grid",
        "Input"
      ]
    },
    {
      "from": [
        "routes_tm",
        "Reprojected"
      ],
      "to": [
        "buffer",
        "Input"
      ]
    },
    {
      "from": [
        "buffer",
        "Buffered"
      ],
      "to": [
        "dissolve",
        "Input"
      ]
    },
    {
      "from": [
        "dissolve",
        "Dissolved"
      ],
      "to": [
        "overlay",
        "Overlay"
      ]
    },
    {
      "from": [
        "short",
        "Output"
      ],
      "to": [
        "overlay",
        "Areas"
      ]
    },
    {
      "from": [
        "overlay",
        "Both"
      ],
      "to": [
        "out_overlay",
        "Input"
      ]
    }
  ]
}
