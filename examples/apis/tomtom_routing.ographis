{
  "format": "ographis/1",
  "name": "TomTom: routes in traffic and reachable ranges",
  "description": "Three uses of the Routing API of TomTom: car routes with alternatives and the delay of the traffic on a Wednesday morning, the route and time to each of the towns, and the areas reached by car in 10, 20 and 30 minutes, written to a GeoPackage and a workbook and drawn on a map. Needs a key from TomTom, under Settings → API connections as TomTom.",
  "variables": [
    {
      "name": "from",
      "value": "57.7069,11.9698"
    },
    {
      "name": "to",
      "value": "57.6955,11.9920"
    },
    {
      "name": "departure",
      "value": "2026-11-04T07:30:00"
    }
  ],
  "nodes": [
    {
      "id": "route",
      "type": "HttpCaller",
      "name": "Car routes in traffic",
      "x": 20,
      "y": 20,
      "comment": "Routing API: by car from Drottningtorget to Liseberg on Wednesday at 07:30, with the traffic of that time, two alternatives and the time without traffic too. One request, as nothing comes in. The key is under Settings → API connections as TomTom, of the kind 'A key only where {{key}} is written'. Get one at developer.tomtom.com",
      "params": {
        "url": "'https://api.tomtom.com/routing/1/calculateRoute/$(from):$(to)/json?travelMode=car&routeType=fastest&traffic=true&departAt=$(departure)&maxAlternatives=2&computeTravelTimeFor=all&key={{key}}'",
        "connection": "TomTom",
        "cache": "disk",
        "timeout": "30"
      }
    },
    {
      "id": "routes",
      "type": "JsonExploder",
      "name": "A feature per route",
      "x": 280,
      "y": 20,
      "params": {
        "attribute": "_response",
        "path": "routes",
        "prefix": "route",
        "index_attr": "alternative"
      }
    },
    {
      "id": "route_pts",
      "type": "JsonExtractor",
      "name": "The points of the route",
      "x": 540,
      "y": 20,
      "params": {
        "attribute": "route.legs",
        "paths": [
          [
            "[0].points",
            "points"
          ]
        ]
      }
    },
    {
      "id": "route_geom",
      "type": "GeometryFromText",
      "name": "Route as a line",
      "x": 800,
      "y": 20,
      "comment": "TomTom gives the route as a list of points with latitude and longitude",
      "params": {
        "attribute": "points",
        "kind": "points",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "route_attrs",
      "type": "AttributeManager",
      "name": "Minutes, km and delay",
      "x": 1060,
      "y": 20,
      "params": {
        "attributes": [],
        "create": [
          {
            "name": "minutes",
            "value": "round(\"route.summary.travelTimeInSeconds\" / 60, 1)"
          },
          {
            "name": "without_traffic",
            "value": "round(\"route.summary.noTrafficTravelTimeInSeconds\" / 60, 1)"
          },
          {
            "name": "delay_minutes",
            "value": "round(\"route.summary.trafficDelayInSeconds\" / 60, 1)"
          },
          {
            "name": "km",
            "value": "round(\"route.summary.lengthInMeters\" / 1000, 1)"
          },
          {
            "name": "leaves",
            "value": "\"route.summary.departureTime\""
          },
          {
            "name": "arrives",
            "value": "\"route.summary.arrivalTime\""
          }
        ]
      }
    },
    {
      "id": "route_keep",
      "type": "AttributeKeeper",
      "name": "The useful attributes",
      "x": 1320,
      "y": 20,
      "params": {
        "keep": "alternative, minutes, without_traffic, delay_minutes, km, leaves, arrives"
      }
    },
    {
      "id": "route_out",
      "type": "Writer",
      "name": "Routes",
      "x": 1580,
      "y": 20,
      "params": {
        "path": "out/tomtom.gpkg",
        "layer": "routes"
      }
    },
    {
      "id": "towns",
      "type": "Reader",
      "name": "Towns",
      "x": 20,
      "y": 220,
      "params": {
        "path": "towns.csv",
        "x": "lon",
        "y": "lat",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "to_town",
      "type": "HttpCaller",
      "name": "From Göteborg to each town",
      "x": 280,
      "y": 220,
      "comment": "A request for each town, at most four a second, as the free plan of TomTom allows five",
      "params": {
        "url": "'https://api.tomtom.com/routing/1/calculateRoute/$(from):' || lat || ',' || lon || '/json?travelMode=car&traffic=true&departAt=$(departure)&key={{key}}'",
        "connection": "TomTom",
        "per_second": "4",
        "cache": "disk",
        "timeout": "30"
      }
    },
    {
      "id": "town_take",
      "type": "JsonExtractor",
      "name": "Time, length and route",
      "x": 540,
      "y": 220,
      "params": {
        "attribute": "_response",
        "paths": [
          [
            "routes[0].summary.travelTimeInSeconds",
            "seconds"
          ],
          [
            "routes[0].summary.trafficDelayInSeconds",
            "delay_seconds"
          ],
          [
            "routes[0].summary.lengthInMeters",
            "metres"
          ],
          [
            "routes[0].legs[0].points",
            "points"
          ]
        ]
      }
    },
    {
      "id": "town_geom",
      "type": "GeometryFromText",
      "name": "Route as a line",
      "x": 800,
      "y": 220,
      "params": {
        "attribute": "points",
        "kind": "points",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "town_attrs",
      "type": "AttributeManager",
      "name": "Minutes and km",
      "x": 1060,
      "y": 220,
      "params": {
        "attributes": [],
        "create": [
          {
            "name": "minutes",
            "value": "round(seconds / 60)"
          },
          {
            "name": "delay_minutes",
            "value": "round(delay_seconds / 60, 1)"
          },
          {
            "name": "km",
            "value": "round(metres / 1000, 1)"
          }
        ]
      }
    },
    {
      "id": "town_keep",
      "type": "AttributeKeeper",
      "name": "The useful attributes",
      "x": 1320,
      "y": 220,
      "params": {
        "keep": "town, minutes, delay_minutes, km"
      }
    },
    {
      "id": "town_out",
      "type": "Writer",
      "name": "To the towns",
      "x": 1580,
      "y": 220,
      "params": {
        "path": "out/tomtom.gpkg",
        "layer": "to_towns"
      }
    },
    {
      "id": "town_csv",
      "type": "Writer",
      "name": "Table of the towns",
      "x": 1580,
      "y": 340,
      "params": {
        "path": "out/tomtom_towns.xlsx",
        "bold_header": "true",
        "freeze": "true"
      }
    },
    {
      "id": "budgets",
      "type": "FeatureCreator",
      "name": "10, 20 and 30 minutes",
      "x": 20,
      "y": 480,
      "comment": "Three features, each named by a number of minutes: a reachable range is asked for each",
      "params": {
        "kind": "point",
        "coordinates": "11.9698 57.7069\n11.9698 57.7069\n11.9698 57.7069",
        "crs": "EPSG:4326",
        "name": "10, 20, 30"
      }
    },
    {
      "id": "budget_s",
      "type": "AttributeCreator",
      "name": "Seconds",
      "x": 280,
      "y": 480,
      "params": {
        "name": "seconds",
        "expression": "to_int(name) * 60"
      }
    },
    {
      "id": "range",
      "type": "HttpCaller",
      "name": "Reachable range by car",
      "x": 540,
      "y": 480,
      "comment": "Reachable Range API: how far one gets from Drottningtorget by car within the time, in the traffic of Wednesday morning",
      "params": {
        "url": "'https://api.tomtom.com/routing/1/calculateReachableRange/$(from)/json?timeBudgetInSec=' || seconds || '&travelMode=car&traffic=true&departAt=$(departure)&key={{key}}'",
        "connection": "TomTom",
        "per_second": "4",
        "cache": "disk",
        "timeout": "30"
      }
    },
    {
      "id": "range_take",
      "type": "JsonExtractor",
      "name": "The boundary",
      "x": 800,
      "y": 480,
      "params": {
        "attribute": "_response",
        "paths": [
          [
            "reachableRange.boundary",
            "boundary"
          ]
        ]
      }
    },
    {
      "id": "range_geom",
      "type": "GeometryFromText",
      "name": "Boundary as an area",
      "x": 1060,
      "y": 480,
      "params": {
        "attribute": "boundary",
        "kind": "points_area",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "range_keep",
      "type": "AttributeCreator",
      "name": "Minutes",
      "x": 1320,
      "y": 480,
      "params": {
        "name": "minutes",
        "expression": "to_int(name)"
      }
    },
    {
      "id": "range_sort",
      "type": "Sorter",
      "name": "Largest first",
      "x": 1580,
      "y": 480,
      "params": {
        "sort_keys": [
          [
            "minutes",
            "descending"
          ]
        ]
      }
    },
    {
      "id": "range_out",
      "type": "Writer",
      "name": "Reachable ranges",
      "x": 1840,
      "y": 480,
      "params": {
        "path": "out/tomtom.gpkg",
        "layer": "reachable"
      }
    },
    {
      "id": "map",
      "type": "MapRenderer",
      "name": "Map of it all",
      "x": 2100,
      "y": 220,
      "params": {
        "width": "1600",
        "crs": "EPSG:3006",
        "background": "#f4f1ea",
        "legend": "bottom-right",
        "legend_title": "TomTom, from Drottningtorget",
        "layers": [
          {
            "from": "route_keep:Output",
            "name": "To Liseberg",
            "fill": "none",
            "stroke": "#d7191c",
            "width": 3.0,
            "size": 4
          },
          {
            "from": "town_keep:Output",
            "name": "To the towns",
            "fill": "none",
            "stroke": "#404040",
            "width": 1.5,
            "size": 4
          },
          {
            "from": "range_sort:Sorted",
            "name": "Reached by car",
            "fill": "#2a78d6",
            "stroke": "#ffffff",
            "width": 1.0,
            "size": 4,
            "color_by": "minutes",
            "ramp": "blues",
            "classes": 3,
            "method": "quantile"
          }
        ]
      }
    },
    {
      "id": "png",
      "type": "Writer",
      "name": "Map as PNG",
      "x": 2360,
      "y": 220,
      "params": {
        "path": "out/tomtom.png"
      }
    }
  ],
  "edges": [
    {
      "from": [
        "route",
        "Output"
      ],
      "to": [
        "routes",
        "Input"
      ]
    },
    {
      "from": [
        "routes",
        "Exploded"
      ],
      "to": [
        "route_pts",
        "Input"
      ]
    },
    {
      "from": [
        "route_pts",
        "Output"
      ],
      "to": [
        "route_geom",
        "Input"
      ]
    },
    {
      "from": [
        "route_geom",
        "Output"
      ],
      "to": [
        "route_attrs",
        "Input"
      ]
    },
    {
      "from": [
        "route_attrs",
        "Output"
      ],
      "to": [
        "route_keep",
        "Input"
      ]
    },
    {
      "from": [
        "route_keep",
        "Output"
      ],
      "to": [
        "route_out",
        "Input"
      ]
    },
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "to_town",
        "Input"
      ]
    },
    {
      "from": [
        "to_town",
        "Output"
      ],
      "to": [
        "town_take",
        "Input"
      ]
    },
    {
      "from": [
        "town_take",
        "Output"
      ],
      "to": [
        "town_geom",
        "Input"
      ]
    },
    {
      "from": [
        "town_geom",
        "Output"
      ],
      "to": [
        "town_attrs",
        "Input"
      ]
    },
    {
      "from": [
        "town_attrs",
        "Output"
      ],
      "to": [
        "town_keep",
        "Input"
      ]
    },
    {
      "from": [
        "town_keep",
        "Output"
      ],
      "to": [
        "town_out",
        "Input"
      ]
    },
    {
      "from": [
        "town_keep",
        "Output"
      ],
      "to": [
        "town_csv",
        "Input"
      ]
    },
    {
      "from": [
        "budgets",
        "Output"
      ],
      "to": [
        "budget_s",
        "Input"
      ]
    },
    {
      "from": [
        "budget_s",
        "Output"
      ],
      "to": [
        "range",
        "Input"
      ]
    },
    {
      "from": [
        "range",
        "Output"
      ],
      "to": [
        "range_take",
        "Input"
      ]
    },
    {
      "from": [
        "range_take",
        "Output"
      ],
      "to": [
        "range_geom",
        "Input"
      ]
    },
    {
      "from": [
        "range_geom",
        "Output"
      ],
      "to": [
        "range_keep",
        "Input"
      ]
    },
    {
      "from": [
        "range_keep",
        "Output"
      ],
      "to": [
        "range_sort",
        "Input"
      ]
    },
    {
      "from": [
        "range_sort",
        "Sorted"
      ],
      "to": [
        "range_out",
        "Input"
      ]
    },
    {
      "from": [
        "route_keep",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "town_keep",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "range_sort",
        "Sorted"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "png",
        "Input"
      ]
    }
  ]
}