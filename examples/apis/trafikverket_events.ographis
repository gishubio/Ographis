{
  "format": "ographis/1",
  "name": "Events on the roads from Trafikverket",
  "nodes": [
    {
      "id": "trv",
      "type": "HttpCaller",
      "x": 20,
      "y": 40,
      "params": {
        "url": "https://api.trafikinfo.trafikverket.se/v2/data.json",
        "method": "POST",
        "content_type": "text/xml",
        "connection": "Trafikverket",
        "body": "'<REQUEST><LOGIN authenticationkey=\"{{key}}\" /><QUERY objecttype=\"Situation\" schemaversion=\"1.5\" limit=\"500\"><FILTER><EQ name=\"Deviation.CountyNo\" value=\"14\" /></FILTER><INCLUDE>Deviation.Header</INCLUDE><INCLUDE>Deviation.MessageType</INCLUDE><INCLUDE>Deviation.StartTime</INCLUDE><INCLUDE>Deviation.Geometry.Point.SWEREF99TM</INCLUDE></QUERY></REQUEST>'"
      },
      "comment": "Trafikverket: events. The key is under Settings → API connections as Trafikverket, of the kind 'A key only where {{key}} is written'. County 14 is Västra Götaland"
    },
    {
      "id": "sit",
      "type": "JsonExploder",
      "x": 300,
      "y": 40,
      "params": {
        "attribute": "_response",
        "path": "RESPONSE.RESULT[0].Situation"
      },
      "comment": "One per situation"
    },
    {
      "id": "dev",
      "type": "JsonExploder",
      "x": 560,
      "y": 40,
      "params": {
        "attribute": "Deviation",
        "path": "",
        "prefix": "d"
      },
      "comment": "One per deviation"
    },
    {
      "id": "geom",
      "type": "GeometryFromText",
      "x": 820,
      "y": 40,
      "params": {
        "attribute": "d.Geometry.Point.SWEREF99TM",
        "crs": "EPSG:3006"
      },
      "comment": "Geometry from WKT"
    },
    {
      "id": "time",
      "type": "AttributeCreator",
      "x": 1080,
      "y": 40,
      "params": {
        "name": "start",
        "expression": "format_time(\"d.StartTime\", '%Y-%m-%d %H:%M')"
      },
      "comment": "Start in Swedish time"
    },
    {
      "id": "out",
      "type": "Writer",
      "x": 1340,
      "y": 40,
      "params": {
        "path": "out/trafikverket.gpkg"
      },
      "comment": "Events"
    }
  ],
  "edges": [
    {
      "from": [
        "trv",
        "Output"
      ],
      "to": [
        "sit",
        "Input"
      ]
    },
    {
      "from": [
        "sit",
        "Exploded"
      ],
      "to": [
        "dev",
        "Input"
      ]
    },
    {
      "from": [
        "dev",
        "Exploded"
      ],
      "to": [
        "geom",
        "Input"
      ]
    },
    {
      "from": [
        "geom",
        "Output"
      ],
      "to": [
        "time",
        "Input"
      ]
    },
    {
      "from": [
        "time",
        "Output"
      ],
      "to": [
        "out",
        "Input"
      ]
    }
  ]
}
