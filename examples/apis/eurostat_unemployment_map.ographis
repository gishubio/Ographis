{
  "format": "ographis/1",
  "name": "Unemployment in the regions of Europe",
  "nodes": [
    {
      "id": "nuts",
      "type": "Reader",
      "name": "NUTS 2 from GISCO",
      "x": 20,
      "y": 40,
      "params": {
        "path": "https://gisco-services.ec.europa.eu/distribution/v2/nuts/geojson/NUTS_RG_20M_2021_4326_LEVL_2.geojson"
      },
      "comment": "Region borders from Eurostat's GISCO, in WGS 84"
    },
    {
      "id": "stat",
      "type": "Reader",
      "name": "Unemployment from Eurostat",
      "x": 20,
      "y": 260,
      "params": {
        "path": "https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data/lfst_r_lfu3rt?sex=T&age=Y20-64&unit=PC&isced11=TOTAL&lastTimePeriod=1"
      },
      "comment": "JSON-stat: Input makes a row for each region"
    },
    {
      "id": "join",
      "type": "FeatureMerger",
      "name": "Join on NUTS code",
      "x": 320,
      "y": 140,
      "params": {
        "requestor_key": "NUTS_ID",
        "supplier_key": "geo"
      }
    },
    {
      "id": "map",
      "type": "MapRenderer",
      "name": "Map",
      "x": 600,
      "y": 140,
      "params": {
        "width": "2000",
        "crs": "EPSG:3035",
        "background": "#f4f1ea",
        "legend": "top-left",
        "legend_title": "Unemployment 20–64 years, %",
        "layers": [
          {
            "from": "join:Merged",
            "name": "Unemployment",
            "fill": "#cccccc",
            "stroke": "#ffffff",
            "width": 0.4,
            "size": 4,
            "color_by": "value",
            "ramp": "reds",
            "classes": 5,
            "method": "quantile"
          }
        ]
      },
      "comment": "Coloured by value, five classes with as many regions in each, in ETRS89 / LAEA Europe"
    },
    {
      "id": "png",
      "type": "Writer",
      "name": "Map as PNG",
      "x": 880,
      "y": 140,
      "params": {
        "path": "out/unemployment_nuts2.png"
      }
    }
  ],
  "edges": [
    {
      "from": [
        "nuts",
        "Output"
      ],
      "to": [
        "join",
        "Requestor"
      ]
    },
    {
      "from": [
        "stat",
        "Output"
      ],
      "to": [
        "join",
        "Supplier"
      ]
    },
    {
      "from": [
        "join",
        "Merged"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "png",
        "Input"
      ]
    }
  ]
}