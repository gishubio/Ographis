{
  "format": "ographis/1",
  "name": "Inhabitants per municipality from Kolada",
  "nodes": [
    {
      "id": "kolada",
      "type": "HttpCaller",
      "x": 20,
      "y": 40,
      "params": {
        "url": "https://api.kolada.se/v3/data/kpi/N01951/year/2025?region_type=municipality",
        "paging": "next",
        "next_path": "next_url"
      },
      "comment": "Kolada: N01951. Kolada API v3 gives its answer in pages: next_url points to the next one"
    },
    {
      "id": "rows",
      "type": "JsonExploder",
      "x": 300,
      "y": 40,
      "params": {
        "attribute": "_response",
        "path": "values"
      },
      "comment": "A value per municipality"
    },
    {
      "id": "sex",
      "type": "JsonExploder",
      "x": 560,
      "y": 40,
      "params": {
        "attribute": "values",
        "path": "",
        "prefix": "v"
      },
      "comment": "Per sex"
    },
    {
      "id": "total",
      "type": "Tester",
      "x": 820,
      "y": 40,
      "params": {
        "test": "\"v.gender\" = 'T'"
      },
      "comment": "Total"
    },
    {
      "id": "out",
      "type": "Writer",
      "x": 1080,
      "y": 40,
      "params": {
        "path": "out/kolada.csv"
      },
      "comment": "Inhabitants"
    }
  ],
  "edges": [
    {
      "from": [
        "kolada",
        "Output"
      ],
      "to": [
        "rows",
        "Input"
      ]
    },
    {
      "from": [
        "rows",
        "Exploded"
      ],
      "to": [
        "sex",
        "Input"
      ]
    },
    {
      "from": [
        "sex",
        "Exploded"
      ],
      "to": [
        "total",
        "Input"
      ]
    },
    {
      "from": [
        "total",
        "Passed"
      ],
      "to": [
        "out",
        "Input"
      ]
    }
  ]
}
