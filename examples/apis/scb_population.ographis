{
  "format": "ographis/1",
  "name": "Population from SCB",
  "nodes": [
    {
      "id": "scb",
      "type": "HttpCaller",
      "x": 20,
      "y": 40,
      "params": {
        "url": "https://api.scb.se/OV0104/v1/doris/sv/ssd/START/BE/BE0101/BE0101A/BefolkningNy",
        "method": "POST",
        "body": "'{\"query\": [{\"code\": \"Region\", \"selection\": {\"filter\": \"vs:RegionKommun07\", \"values\": [\"1480\", \"1490\", \"1495\", \"1496\", \"1497\"]}}, {\"code\": \"ContentsCode\", \"selection\": {\"filter\": \"item\", \"values\": [\"BE0101N1\"]}}, {\"code\": \"Tid\", \"selection\": {\"filter\": \"top\", \"values\": [\"3\"]}}], \"response\": {\"format\": \"json-stat2\"}}'",
        "content_type": "application/json"
      },
      "comment": "SCB: population. PxWeb: the query is sent as JSON, and the answer comes as json-stat2"
    },
    {
      "id": "stat",
      "type": "JsonStatReader",
      "x": 300,
      "y": 40,
      "params": {
        "attribute": "_response",
        "columns_from": "Tid"
      },
      "comment": "A column for each year"
    },
    {
      "id": "out",
      "type": "Writer",
      "x": 560,
      "y": 40,
      "params": {
        "path": "out/population.xlsx"
      },
      "comment": "Population"
    }
  ],
  "edges": [
    {
      "from": [
        "scb",
        "Output"
      ],
      "to": [
        "stat",
        "Input"
      ]
    },
    {
      "from": [
        "stat",
        "Output"
      ],
      "to": [
        "out",
        "Input"
      ]
    }
  ]
}
