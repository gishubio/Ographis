{
  "format": "ographis/1",
  "name": "A hospital building from IFC",
  "nodes": [
    {
      "id": "hospital",
      "type": "Reader",
      "name": "Input",
      "x": 43.0,
      "y": -95.0,
      "params": {
        "path": "hospital/hospital.ifc"
      },
      "comment": "A made-up hospital in IFC4: five floors, walls, windows, doors, columns, rooms, a stair, lifts and beds, placed in SWEREF 99 TM"
    },
    {
      "id": "valuefilter_1",
      "type": "ValueFilter",
      "name": "Filter by value",
      "x": 307.0,
      "y": 373.0,
      "params": {
        "attribute": "IfcClass",
        "values": [
          "IfcSlab",
          "IfcWall",
          "IfcWindow",
          "IfcDoor",
          "IfcStairFlight",
          "IfcTransportElement",
          "IfcColumn",
          "IfcFurniture",
          "IfcBuildingElementProxy"
        ]
      },
      "comment": "One stream for each kind of element",
      "comment_box": [
        0.0,
        -44.0,
        230.0,
        26.0
      ]
    },
    {
      "id": "sorter_1",
      "type": "Sorter",
      "name": "Sort",
      "x": 308.0,
      "y": 141.0,
      "params": {
        "sort_keys": [
          [
            "IfcClass",
            "ascending"
          ],
          [
            "storey",
            "ascending"
          ]
        ]
      },
      "comment": "Sort for excel file",
      "comment_box": [
        3.0,
        -42.0,
        106.0,
        26.0
      ]
    },
    {
      "id": "scene",
      "type": "SceneRenderer",
      "name": "Render 3D scene",
      "x": 315.0,
      "y": -169.0,
      "params": {
        "background": "sky",
        "date": "2026-06-15",
        "elevation": "25",
        "height": "1000",
        "quality": "16",
        "sun": "date",
        "time": "14:00",
        "view_azimuth": "200",
        "width": "1600",
        "zoom": "100"
      },
      "comment": "The building in 3D",
      "comment_box": [
        19.0,
        -42.0,
        116.0,
        26.0
      ]
    },
    {
      "id": "outlinefromabove_1",
      "type": "OutlineFromAbove",
      "name": "Outline from above",
      "x": 620.0,
      "y": 376.0,
      "params": {
        "cut": "1"
      },
      "comment": "3D -> 2D\nAs seen from 1m above the floor",
      "comment_box": [
        -17.0,
        -65.0,
        192.0,
        45.0
      ]
    },
    {
      "id": "valuefilter_2",
      "type": "ValueFilter",
      "name": "Filter by value 2",
      "x": 866.0,
      "y": 378.0,
      "params": {
        "attribute": "storey",
        "values": [
          "Ground floor",
          "Level 1",
          "Level 2",
          "Level 3",
          "Level 4"
        ]
      },
      "comment": "Just to see number of walls for each floor",
      "comment_box": [
        0.0,
        -60.0,
        140.0,
        42.0
      ]
    },
    {
      "id": "list",
      "type": "Writer",
      "name": "Output",
      "x": 1113.0,
      "y": 162.0,
      "params": {
        "geometry": "none",
        "path": "out/hospital_elements.xlsx"
      },
      "comment": "Every element with its storey, properties and quantities\nXLSX",
      "comment_box": [
        -13.0,
        -71.0,
        184.0,
        57.0
      ]
    },
    {
      "id": "png",
      "type": "Writer",
      "name": "Output",
      "x": 1118.0,
      "y": -119.0,
      "params": {
        "path": "out/hospital.png"
      },
      "comment": "Rendered image\nPNG",
      "comment_box": [
        -9.0,
        -60.0,
        109.0,
        45.0
      ]
    },
    {
      "id": "writer_1",
      "type": "PostgisWriter",
      "name": "PostGIS output",
      "x": 1129.0,
      "y": 378.0,
      "params": {
        "connection": "PostGIS localhost",
        "format": "postgis",
        "key": "attribute",
        "key_attribute": "GlobalId",
        "schema": "public",
        "table": "hospital_level_1"
      },
      "comment": "2D floor plan of level 1 from the walls\nPostGIS: turned on, with a connection of your own",
      "comment_box": [
        7.0,
        -55.0,
        149.0,
        42.0
      ],
      "disabled": true
    },
    {
      "id": "walls_gpkg",
      "type": "Writer",
      "name": "Output",
      "x": 1129.0,
      "y": 560.0,
      "params": {
        "path": "out/hospital_level_1_walls.gpkg"
      },
      "comment": "2D floor plan of level 1 from the walls\nGeoPackage",
      "comment_box": [
        7.0,
        -55.0,
        149.0,
        42.0
      ]
    }
  ],
