{
  "format": "ographis/1",
  "name": "Winter and light in the village",
  "description": "The made-up village in 3D seven times: a frosty morning with rime, icicles, a frozen pond, smoke and rays of sun; an advent evening with candles and stars in the windows, light cones under the lamps and the trails of cars; fireworks on New Year's Eve; a rainbow with the shadows of clouds; an autumn gale; a tilt-shift model village; and a short December day from sunrise to sunset as a sheet and a moving picture.",
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 40,
      "y": 40,
      "comment": "The made-up terrain, all of it, so that the land reaches the horizon",
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid"
      }
    },
    {
      "id": "town",
      "type": "Reader",
      "x": 40,
      "y": 180,
      "comment": "The houses of the village",
      "params": {
        "path": "town.geojson"
      }
    },
    {
      "id": "make",
      "type": "BuildingMaker",
      "x": 300,
      "y": 180,
      "comment": "Houses with roofs, on the terrain",
      "params": {}
    },
    {
      "id": "trees",
