{
  "format": "ographis/1",
  "name": "Counting with rasters",
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid"
      },
      "comment": "Terrain, 20 m"
    },
    {
      "id": "coarse",
      "type": "RasterGeneralizer",
      "x": 280,
      "y": 20,
      "params": {
        "factor": "4",
        "method": "mean"
      },
      "comment": "80 m cells"
    },
    {
      "id": "relief",
      "type": "RasterCalculator",
      "x": 540,
      "y": 20,
      "comment": "Above or below the surroundings. A is the terrain, B the mean of each 80 m square: what sticks up is positive",
      "params": {
        "expression": "A - B"
      }
    },
    {
      "id": "classes",
      "type": "RasterCalculator",
      "x": 280,
      "y": 200,
      "params": {
        "expression": "CASE WHEN A < 100 THEN 1 WHEN A < 150 THEN 2 WHEN A < 200 THEN 3 ELSE 4 END"
      },
      "comment": "Height classes"
    },
    {
      "id": "major",
      "type": "RasterGeneralizer",
      "x": 540,
      "y": 200,
      "params": {
        "factor": "16",
        "method": "majority"
      },
      "comment": "Most common class, 320 m"
    },
    {
      "id": "view",
      "type": "Viewer",
      "x": 800,
      "y": 100,
      "params": {},
      "comment": "Look at it"
    },
    {
      "id": "out",
      "type": "Writer",
      "x": 800,
      "y": 260,
      "params": {
        "path": "out/relief.tif"
      },
      "comment": "Relief"
    }
  ],
  "edges": [
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "coarse",
        "Raster"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "relief",
        "Rasters"
      ]
    },
    {
      "from": [
        "coarse",
        "Raster"
      ],
      "to": [
        "relief",
        "Rasters"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "classes",
        "Rasters"
      ]
    },
    {
      "from": [
        "classes",
        "Raster"
      ],
      "to": [
        "major",
        "Raster"
      ]
    },
    {
      "from": [
        "relief",
        "Raster"
      ],
      "to": [
        "view",
        "Input"
      ]
    },
    {
      "from": [
        "major",
        "Raster"
      ],
      "to": [
        "view",
        "Input"
      ]
    },
    {
      "from": [
        "relief",
        "Raster"
      ],
      "to": [
        "out",
        "Input"
      ]
    }
  ]
}
