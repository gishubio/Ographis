{
  "format": "ographis/1",
  "name": "Build test: GeoPackage to Shapefile in SWEREF 99 TM",
  "nodes": [
    {
      "id": "in",
      "type": "Reader",
      "x": 40,
      "y": 40,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "sweref",
      "type": "Reprojector",
      "x": 260,
      "y": 40,
      "params": {
        "crs": "EPSG:3006"
      }
    },
    {
      "id": "out",
      "type": "Writer",
      "x": 480,
      "y": 40,
      "params": {
        "path": "out/subregions_sweref.shp"
      },
      "comment": "Subregions SWEREF"
    }
  ],
  "edges": [
    {
      "from": [
        "in",
        "Output"
      ],
      "to": [
        "sweref",
        "Input"
      ]
    },
    {
      "from": [
        "sweref",
        "Reprojected"
      ],
      "to": [
        "out",
        "Input"
      ]
    }
  ]
}
