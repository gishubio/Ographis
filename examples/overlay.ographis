{
  "format": "ographis/1",
  "name": "Population and route corridors by subregion",
  "nodes": [
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "towns_sweref",
      "type": "Reprojector",
      "x": 232,
      "y": 20,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Towns to SWEREF"
    },
    {
      "id": "join",
      "type": "SpatialJoiner",
      "x": 444,
      "y": 20,
      "params": {
        "attributes": "subregion",
        "relation": "point"
      },
      "comment": "Which subregion?"
    },
    {
      "id": "stats",
      "type": "StatisticsCalculator",
      "x": 656,
      "y": 20,
      "params": {
        "attributes": "population",
        "group_by": "subregion"
      },
      "comment": "Population by subregion"
    },
    {
      "id": "sort",
      "type": "Sorter",
      "x": 868,
      "y": 20,
      "params": {
        "sort_by": "population_sum",
        "order": "descending"
      },
      "comment": "Largest first"
    },
    {
      "id": "out_stats",
      "type": "Writer",
      "x": 1080,
      "y": 20,
      "params": {
        "path": "out/population_by_subregion.csv"
      },
      "comment": "Population table"
    },
    {
      "id": "subregions",
      "type": "Reader",
      "x": 20,
      "y": 200,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "areas_sweref",
      "type": "Reprojector",
      "x": 232,
      "y": 200,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Areas to SWEREF"
    },
    {
      "id": "count",
      "type": "PointCounter",
      "x": 444,
      "y": 200,
      "params": {
        "name": "towns"
      },
      "comment": "Towns per subregion"
    },
    {
      "id": "out_areas",
      "type": "Writer",
      "x": 656,
      "y": 200,
      "params": {
        "path": "out/overlay.gpkg",
        "layer": "subregions"
      },
      "comment": "Subregions with town count"
    },
    {
      "id": "labels",
      "type": "CenterPointReplacer",
      "x": 656,
      "y": 330,
      "params": {
        "mode": "inside"
      },
      "comment": "Label points"
    },
    {
      "id": "out_labels",
      "type": "Writer",
      "x": 868,
      "y": 330,
      "params": {
        "path": "out/overlay.gpkg",
        "layer": "label_points"
      },
      "comment": "Label points"
    },
    {
      "id": "routes",
      "type": "Reader",
      "x": 20,
      "y": 480,
      "params": {
        "path": "routes.shp"
      },
      "comment": "Routes"
    },
    {
      "id": "buffer",
      "type": "Bufferer",
      "x": 232,
      "y": 480,
      "params": {
        "distance": "2000"
      },
      "comment": "2 km on each side"
    },
    {
      "id": "dissolve",
      "type": "Dissolver",
      "x": 444,
      "y": 480,
      "params": {
        "group_by": "type",
        "parts": "together"
      },
      "comment": "One corridor per type"
    },
    {
      "id": "corridor_area",
      "type": "AreaCalculator",
      "x": 656,
      "y": 480,
      "params": {
        "name": "area_km2",
        "unit": "km2"
      },
      "comment": "Corridor area"
    },
    {
      "id": "out_corridors",
      "type": "Writer",
      "x": 868,
      "y": 480,
      "params": {
        "path": "out/overlay.gpkg",
        "layer": "corridors"
      },
      "comment": "Corridors"
    }
  ],
  "edges": [
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "towns_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "towns_sweref",
        "Reprojected"
      ],
      "to": [
        "join",
        "Features"
      ]
    },
    {
      "from": [
        "towns_sweref",
        "Reprojected"
      ],
      "to": [
        "count",
        "Points"
      ]
    },
    {
      "from": [
        "subregions",
        "Output"
      ],
      "to": [
        "areas_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "areas_sweref",
        "Reprojected"
      ],
      "to": [
        "join",
        "Join"
      ]
    },
    {
      "from": [
        "areas_sweref",
        "Reprojected"
      ],
      "to": [
        "count",
        "Polygons"
      ]
    },
    {
      "from": [
        "join",
        "Joined"
      ],
      "to": [
        "stats",
        "Input"
      ]
    },
    {
      "from": [
        "stats",
        "Summary"
      ],
      "to": [
        "sort",
        "Input"
      ]
    },
    {
      "from": [
        "sort",
        "Sorted"
      ],
      "to": [
        "out_stats",
        "Input"
      ]
    },
    {
      "from": [
        "count",
        "Polygons"
      ],
      "to": [
        "out_areas",
        "Input"
      ]
    },
    {
      "from": [
        "count",
        "Polygons"
      ],
      "to": [
        "labels",
        "Input"
      ]
    },
    {
      "from": [
        "labels",
        "Point"
      ],
      "to": [
        "out_labels",
        "Input"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "buffer",
        "Input"
      ]
    },
    {
      "from": [
        "buffer",
        "Buffered"
      ],
      "to": [
        "dissolve",
        "Input"
      ]
    },
    {
      "from": [
        "dissolve",
        "Dissolved"
      ],
      "to": [
        "corridor_area",
        "Input"
      ]
    },
    {
      "from": [
        "corridor_area",
        "Output"
      ],
      "to": [
        "out_corridors",
        "Input"
      ]
    }
  ]
}
