{
  "format": "ographis/1",
  "name": "A drone point cloud",
  "description": "A made-up point cloud as a drone gives it, without classes: the ground is found, a terrain model and a surface model are made of it, and five buildings are measured, with the shapes of their roofs.",
  "nodes": [
    {
      "id": "cloud",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "pointcloud/drone_points.laz"
      },
      "comment": "Drone points"
    },
    {
      "id": "footprints",
      "type": "Reader",
      "x": 20,
      "y": 420,
      "params": {
        "path": "pointcloud/footprints.geojson"
      },
      "comment": "Footprints"
    },
    {
      "id": "ground",
      "type": "GroundClassifier",
      "x": 280,
      "y": 20,
      "params": {
        "window": "30"
      },
      "comment": "Find the ground"
    },
    {
      "id": "dem",
      "type": "PointCloudRasterizer",
      "x": 540,
      "y": 120,
      "params": {
        "stat": "min",
        "fill": "50"
      },
      "comment": "Terrain model, 1 m"
    },
    {
      "id": "dsm",
      "type": "PointCloudRasterizer",
      "x": 540,
      "y": -60,
      "params": {
        "stat": "max",
        "fill": "3"
      },
      "comment": "Surface model, 1 m"
    },
    {
      "id": "above",
      "type": "HeightAboveGround",
      "x": 800,
      "y": 20,
      "params": {}
    },
    {
      "id": "tall",
      "type": "PointCloudFilter",
      "x": 1060,
      "y": 20,
      "params": {
        "zmin": "2",
        "height_of": "above_ground"
      },
      "comment": "Above 2 m"
    },
    {
      "id": "houses",
      "type": "BuildingHeights",
      "x": 800,
      "y": 300,
      "params": {},
      "comment": "Measure the buildings"
    },
    {
      "id": "out_dem",
      "type": "Writer",
      "x": 800,
      "y": 160,
      "params": {
        "path": "out/drone_terrain.tif"
      },
      "comment": "Terrain model"
    },
    {
      "id": "out_dsm",
      "type": "Writer",
      "x": 800,
      "y": -100,
      "params": {
        "path": "out/drone_surface.tif"
      },
      "comment": "Surface model"
    },
    {
      "id": "out_tall",
      "type": "Writer",
      "x": 1320,
      "y": 20,
      "params": {
        "path": "out/drone_above_2m.laz"
      },
      "comment": "Trees and roofs"
    },
    {
      "id": "out_houses",
      "type": "Writer",
      "x": 1060,
      "y": 300,
      "params": {
        "path": "out/building_heights.gpkg"
      },
      "comment": "Buildings"
    }
  ],
  "edges": [
    {
      "from": [
        "cloud",
        "Output"
      ],
      "to": [
        "ground",
        "Points"
      ]
    },
    {
      "from": [
        "ground",
        "Ground"
      ],
      "to": [
        "dem",
        "Points"
      ]
    },
    {
      "from": [
        "cloud",
        "Output"
      ],
      "to": [
        "dsm",
        "Points"
      ]
    },
    {
      "from": [
        "dem",
        "Raster"
      ],
      "to": [
        "out_dem",
        "Input"
      ]
    },
    {
      "from": [
        "dsm",
        "Raster"
      ],
      "to": [
        "out_dsm",
        "Input"
      ]
    },
    {
      "from": [
        "ground",
        "Points"
      ],
      "to": [
        "above",
        "Points"
      ]
    },
    {
      "from": [
        "dem",
        "Raster"
      ],
      "to": [
        "above",
        "Ground"
      ]
    },
    {
      "from": [
        "above",
        "Points"
      ],
      "to": [
        "tall",
        "Points"
      ]
    },
    {
      "from": [
        "tall",
        "Points"
      ],
      "to": [
        "out_tall",
        "Input"
      ]
    },
    {
      "from": [
        "footprints",
        "Output"
      ],
      "to": [
        "houses",
        "Buildings"
      ]
    },
    {
      "from": [
        "ground",
        "Points"
      ],
      "to": [
        "houses",
        "Points"
      ]
    },
    {
      "from": [
        "dem",
        "Raster"
      ],
      "to": [
        "houses",
        "Ground"
      ]
    },
    {
      "from": [
        "houses",
        "Buildings"
      ],
      "to": [
        "out_houses",
        "Input"
      ]
    }
  ]
}
