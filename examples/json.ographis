{
  "format": "ographis/1",
  "name": "Open data from Västra Götalandsregionen as JSON",
  "nodes": [
    {
      "id": "units",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "https://vgregion.entryscape.net/rowstore/dataset/c5491a87-e5a0-4edb-80fe-2c76a0696902/json"
      },
      "comment": "Hospitals (open data)"
    },
    {
      "id": "points",
      "type": "PointCreator",
      "x": 260,
      "y": 20,
      "params": {
        "x": "ykoord",
        "y": "xkoord",
        "crs": "EPSG:3006"
      },
      "comment": "Points from xkoord and ykoord"
    },
    {
      "id": "gpkg",
      "type": "Writer",
      "x": 520,
      "y": 20,
      "params": {
        "path": "out/hospitals.gpkg"
      },
      "comment": "Hospitals file"
    },
    {
      "id": "json",
      "type": "JsonBuilder",
      "x": 520,
      "y": 160,
      "params": {
        "attributes": [
          "namn",
          "gatunamn",
          "gatunummer",
          "postnummer",
          "postort"
        ],
        "result": "json"
      },
      "comment": "Address as JSON"
    },
    {
      "id": "csv",
      "type": "Writer",
      "x": 760,
      "y": 160,
      "params": {
        "path": "out/hospitals_json.csv"
      },
      "comment": "Addresses as JSON in CSV"
    }
  ],
  "edges": [
    {
      "from": [
        "units",
        "Output"
      ],
      "to": [
        "points",
        "Input"
      ]
    },
    {
      "from": [
        "points",
        "Points"
      ],
      "to": [
        "gpkg",
        "Input"
      ]
    },
    {
      "from": [
        "points",
        "Points"
      ],
      "to": [
        "json",
        "Input"
      ]
    },
    {
      "from": [
        "json",
        "Output"
      ],
      "to": [
        "csv",
        "Input"
      ]
    }
  ]
}
