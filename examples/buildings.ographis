{
  "format": "ographis/1",
  "name": "Buildings that look real",
  "description": "A made-up village drawn with the attributes of OpenStreetMap, raised by Make buildings into houses with gable and hipped roofs, flats of brick, an office of glass, a church with its tower and a hall of sheet metal, on the made-up terrain. The scene is rendered as a picture and written as a walk-through to open in a browser.",
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 40,
      "y": 60,
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid",
        "within": "rectangle",
        "min_x": "418100",
        "min_y": "6472350",
        "max_x": "418500",
        "max_y": "6472700"
      }
    },
    {
      "id": "town",
      "type": "Reader",
      "x": 40,
      "y": 200,
      "params": {
        "path": "town.geojson"
      }
    },
    {
      "id": "make",
      "type": "BuildingMaker",
      "x": 300,
      "y": 200,
      "params": {}
    },
    {
      "id": "ground",
      "type": "TerrainModel",
      "x": 300,
      "y": 60,
      "params": {
        "most": "200"
      }
    },
    {
      "id": "scene",
      "type": "SceneRenderer",
      "x": 560,
      "y": 120,
      "params": {}
    },
    {
      "id": "png",
      "type": "Writer",
      "x": 800,
      "y": 60,
      "params": {
        "path": "out/buildings.png"
      }
    },
    {
      "id": "walk",
      "type": "Writer",
      "x": 800,
      "y": 220,
      "params": {
        "path": "out/walk_village",
        "format": "walk",
        "walk_start": "418290, 6472495",
        "gltf_when": "2026-06-21 18:00"
      }
    }
  ],
  "edges": [
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "make",
        "Terrain"
      ]
    },
    {
      "from": [
        "town",
        "Output"
      ],
      "to": [
        "make",
        "Buildings"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "ground",
        "Heights"
      ]
    },
    {
      "from": [
        "make",
        "Buildings"
      ],
      "to": [
        "scene",
        "Models"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "scene",
        "Terrain"
      ]
    },
    {
      "from": [
        "scene",
        "Image"
      ],
      "to": [
        "png",
