{
  "format": "ographis/1",
  "name": "The area nearest each town",
  "nodes": [
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "areas",
      "type": "Reader",
      "x": 20,
      "y": 200,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "towns_tm",
      "type": "Reprojector",
      "x": 240,
      "y": 20,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Towns to SWEREF"
    },
    {
      "id": "areas_tm",
      "type": "Reprojector",
      "x": 240,
      "y": 200,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Subregions to SWEREF"
    },
    {
      "id": "number",
      "type": "Counter",
      "x": 470,
      "y": 20,
      "params": {
        "name": "town_no"
      },
      "comment": "Number the towns"
    },
    {
      "id": "cells",
      "type": "VoronoiDiagrammer",
      "x": 700,
      "y": 80,
      "comment": "Nearest town. Each town gets the part of the subregions that is nearer to it than to any other town",
      "params": {}
    },
    {
      "id": "edges",
      "type": "PolygonToLine",
      "x": 940,
      "y": 200,
      "params": {},
      "comment": "Borders as lines"
    },
    {
      "id": "box",
      "type": "BoundingBoxAccumulator",
      "x": 470,
      "y": 320,
      "params": {
        "corners": "true"
      },
      "comment": "Extent"
    },
    {
      "id": "out_cells",
      "type": "Writer",
      "x": 940,
      "y": 40,
      "params": {
        "path": "out/nearest_town.gpkg"
      },
      "comment": "Nearest town areas"
    },
    {
      "id": "out_lines",
      "type": "Writer",
      "x": 1160,
      "y": 200,
      "params": {
        "path": "out/nearest_town_borders.gpkg"
      },
      "comment": "Border lines"
    },
    {
      "id": "out_box",
      "type": "Writer",
      "x": 700,
      "y": 320,
      "params": {
        "path": "out/extent.geojson"
      },
      "comment": "Extent as GeoJSON"
    }
  ],
  "edges": [
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "towns_tm",
        "Input"
      ]
    },
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "areas_tm",
        "Input"
      ]
    },
    {
      "from": [
        "towns_tm",
        "Reprojected"
      ],
      "to": [
        "number",
        "Input"
      ]
    },
    {
      "from": [
        "number",
        "Output"
      ],
      "to": [
        "cells",
        "Points"
      ]
    },
    {
      "from": [
        "areas_tm",
        "Reprojected"
      ],
      "to": [
        "cells",
        "Boundary"
      ]
    },
    {
      "from": [
        "cells",
        "Polygons"
      ],
      "to": [
        "out_cells",
        "Input"
      ]
    },
    {
      "from": [
        "cells",
        "Polygons"
      ],
      "to": [
        "edges",
        "Input"
      ]
    },
    {
      "from": [
        "edges",
        "Lines"
      ],
      "to": [
        "out_lines",
        "Input"
      ]
    },
    {
      "from": [
        "areas_tm",
        "Reprojected"
      ],
      "to": [
        "box",
        "Input"
      ]
    },
    {
      "from": [
        "box",
        "Output"
      ],
      "to": [
        "out_box",
        "Input"
      ]
    }
  ]
}
