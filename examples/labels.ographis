{
  "format": "ographis/1",
  "name": "Labels and icons",
  "nodes": [
    {
      "id": "areas",
      "type": "Reader",
      "name": "Subregions",
      "x": 20,
      "y": 20,
      "params": {
        "path": "subregions.gpkg"
      }
    },
    {
      "id": "routes",
      "type": "Reader",
      "name": "Routes",
      "x": 20,
      "y": 160,
      "params": {
        "path": "routes.shp"
      }
    },
    {
      "id": "towns",
      "type": "Reader",
      "name": "Towns",
      "x": 20,
      "y": 300,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "places",
      "type": "Reader",
      "name": "Places in Skövde",
      "x": 20,
      "y": 560,
      "comment": "Made up, with the kind of place as in OpenStreetMap or in Swedish",
      "params": {
        "path": "places.geojson"
      }
    },
    {
      "id": "map",
      "type": "MapRenderer",
      "name": "Labelled map",
      "x": 300,
      "y": 120,
      "comment": "Towns sized and placed by population, where there is room",
      "params": {
        "width": "1600",
        "crs": "EPSG:3006",
        "legend": "bottom-right",
        "legend_title": "Skaraborg",
        "layers": [
          {
            "from": "towns:Output",
            "fill": "#000000",
            "stroke": "#ffffff",
            "width": 1.5,
            "size": 8,
            "label": "name",
            "label_size": 12,
            "label_size_by": "population",
            "label_size_max": 22,
            "label_priority": "population"
          },
          {
            "from": "routes:Output",
            "fill": "none",
            "stroke": "#b2182b",
            "width": 2.5,
            "size": 6,
            "label": "name",
            "label_colour": "#7f0f1e",
            "label_size": 13
          },
          {
            "from": "areas:Output",
            "fill": "#e3eef7",
            "stroke": "#4a7fb0",
            "width": 1.5,
            "size": 6,
            "label": "subregion",
            "label_place": "center",
            "label_upper": true,
            "label_bold": true,
            "label_colour": "#4a7fb0",
            "label_size": 18,
            "label_halo": "none"
          }
        ]
      }
    },
    {
      "id": "pois",
      "type": "MapRenderer",
      "name": "Places with icons",
      "x": 300,
      "y": 540,
      "params": {
        "width": "1400",
        "background": "#f4f1ea",
        "legend": "top-right",
        "legend_title": "Places",
        "layers": [
          {
            "from": "places:Output",
            "fill": "#1f5f8b",
            "stroke": "#ffffff",
            "width": 1.5,
            "size": 26,
            "icon_by": "amenity",
            "icon_style": "circle",
            "label": "name",
            "label_size": 13
          }
        ]
      }
    },
    {
      "id": "png",
      "type": "Writer",
      "name": "Labelled map",
      "x": 560,
      "y": 120,
      "params": {
        "path": "out/labels.png"
      }
    },
    {
      "id": "poipng",
      "type": "Writer",
      "name": "Places",
      "x": 560,
      "y": 520,
      "params": {
        "path": "out/places.png"
      }
    },
    {
      "id": "poipdf",
      "type": "Writer",
      "name": "Places for print",
      "x": 560,
      "y": 640,
      "params": {
        "path": "out/places.pdf",
        "pdf_size": "a3",
        "pdf_title": "Places in Skövde"
      }
    }
  ],
  "edges": [
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "places",
        "Output"
      ],
      "to": [
        "pois",
        "Layers"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "png",
        "Input"
      ]
    },
    {
      "from": [
        "pois",
        "Map"
      ],
      "to": [
        "poipng",
        "Input"
      ]
    },
    {
      "from": [
        "pois",
        "Map"
      ],
      "to": [
        "poipdf",
        "Input"
      ]
    }
  ]
}