{
  "format": "ographis/1",
  "name": "Towns and routes in Skaraborg",
  "nodes": [
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "towns_sweref",
      "type": "Reprojector",
      "x": 232,
      "y": 20,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Towns to SWEREF"
    },
    {
      "id": "clip_towns",
      "type": "Clipper",
      "x": 656,
      "y": 20,
      "params": {},
      "comment": "Clip towns"
    },
    {
      "id": "join",
      "type": "FeatureMerger",
      "x": 868,
      "y": 20,
      "params": {
        "requestor_key": "municipality",
        "supplier_key": "municipality"
      },
      "comment": "Join municipality code"
    },
    {
      "id": "thousands",
      "type": "AttributeCreator",
      "x": 1080,
      "y": 20,
      "params": {
        "name": "pop_thousands",
        "expression": "round(population / 1000, 1)"
      },
      "comment": "Population in thousands"
    },
    {
      "id": "out_towns",
      "type": "Writer",
      "x": 1292,
      "y": 20,
      "params": {
        "path": "out/skaraborg.gpkg",
        "layer": "towns"
      },
      "comment": "Towns in Skaraborg"
    },
    {
      "id": "municipalities",
      "type": "Reader",
      "x": 656,
      "y": 200,
      "params": {
        "path": "municipalities.csv"
      },
      "comment": "Municipalities"
    },
    {
      "id": "outside",
      "type": "AttributeManager",
      "x": 868,
      "y": 200,
      "params": {
        "attributes": [
          {
            "name": "name",
            "action": "rename",
            "to": "town"
          },
          {
            "name": "municipality"
          },
          {
            "name": "population"
          }
        ],
        "others": "remove"
      },
      "comment": "Choose attributes"
    },
    {
      "id": "out_outside",
      "type": "Writer",
      "x": 1080,
      "y": 200,
      "params": {
        "path": "out/towns_outside.csv",
        "encoding": "utf-8-bom"
      },
      "comment": "Towns outside"
    },
    {
      "id": "subregions",
      "type": "Reader",
      "x": 20,
      "y": 230,
      "params": {
        "path": "subregions.gpkg",
        "layer": "subregions"
      },
      "comment": "Subregions"
    },
    {
      "id": "areas_sweref",
      "type": "Reprojector",
      "x": 232,
      "y": 230,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Areas to SWEREF"
    },
    {
      "id": "skaraborg",
      "type": "Tester",
      "x": 444,
      "y": 230,
      "params": {
        "test": "subregion = 'Skaraborg'"
      },
      "comment": "Only Skaraborg"
    },
    {
      "id": "area",
      "type": "AreaCalculator",
      "x": 656,
      "y": 350,
      "params": {
        "name": "area_km2",
        "unit": "km2"
      }
    },
    {
      "id": "out_area",
      "type": "Writer",
      "x": 868,
      "y": 350,
      "params": {
        "path": "out/skaraborg_area.shp"
      },
      "comment": "Skaraborg area"
    },
    {
      "id": "routes",
      "type": "Reader",
      "x": 20,
      "y": 500,
      "params": {
        "path": "routes.shp"
      },
      "comment": "Routes"
    },
    {
      "id": "clip_routes",
      "type": "Clipper",
      "x": 656,
      "y": 500,
      "params": {},
      "comment": "Clip routes"
    },
    {
      "id": "length",
      "type": "LengthCalculator",
      "x": 868,
      "y": 500,
      "params": {
        "name": "length_km",
        "unit": "km"
      }
    },
    {
      "id": "out_routes",
      "type": "Writer",
      "x": 1080,
      "y": 500,
      "params": {
        "path": "out/skaraborg.gpkg",
        "layer": "routes"
      },
      "comment": "Routes in Skaraborg"
    }
  ],
  "edges": [
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "towns_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "towns_sweref",
        "Reprojected"
      ],
      "to": [
        "clip_towns",
        "Clippee"
      ]
    },
    {
      "from": [
        "skaraborg",
        "Passed"
      ],
      "to": [
        "clip_towns",
        "Clipper"
      ]
    },
    {
      "from": [
        "clip_towns",
        "Inside"
      ],
      "to": [
        "join",
        "Requestor"
      ]
    },
    {
      "from": [
        "municipalities",
        "Output"
      ],
      "to": [
        "join",
        "Supplier"
      ]
    },
    {
      "from": [
        "join",
        "Merged"
      ],
      "to": [
        "thousands",
        "Input"
      ]
    },
    {
      "from": [
        "thousands",
        "Output"
      ],
      "to": [
        "out_towns",
        "Input"
      ]
    },
    {
      "from": [
        "clip_towns",
        "Outside"
      ],
      "to": [
        "outside",
        "Input"
      ]
    },
    {
      "from": [
        "outside",
        "Output"
      ],
      "to": [
        "out_outside",
        "Input"
      ]
    },
    {
      "from": [
        "subregions",
        "Output"
      ],
      "to": [
        "areas_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "areas_sweref",
        "Reprojected"
      ],
      "to": [
        "skaraborg",
        "Input"
      ]
    },
    {
      "from": [
        "skaraborg",
        "Passed"
      ],
      "to": [
        "area",
        "Input"
      ]
    },
    {
      "from": [
        "area",
        "Output"
      ],
      "to": [
        "out_area",
        "Input"
      ]
    },
    {
      "from": [
        "skaraborg",
        "Passed"
      ],
      "to": [
        "clip_routes",
        "Clipper"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "clip_routes",
        "Clippee"
      ]
    },
    {
      "from": [
        "clip_routes",
        "Inside"
      ],
      "to": [
        "length",
        "Input"
      ]
    },
    {
      "from": [
        "length",
        "Output"
      ],
      "to": [
        "out_routes",
        "Input"
      ]
    }
  ]
}
