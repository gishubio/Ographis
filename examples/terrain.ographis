{
  "format": "ographis/1",
  "name": "Terrain with light and shadows",
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "comment": "Terrain model. A made-up terrain, 12.8 × 9.6 km in cells of 20 m",
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid"
      }
    },
    {
      "id": "water",
      "type": "Reader",
      "x": 20,
      "y": 220,
      "params": {
        "path": "water.geojson"
      },
      "comment": "Water"
    },
    {
      "id": "lakes",
      "type": "Tester",
      "x": 240,
      "y": 220,
      "params": {
        "test": "kind = 'lake'"
      },
      "comment": "Lakes"
    },
    {
      "id": "map",
      "type": "MapRenderer",
      "x": 460,
      "y": 220,
      "params": {
        "width": "2000",
        "margin": "0",
        "background": "none",
        "crs": "EPSG:3006",
        "layers": [
          {
            "from": "lakes:Failed",
            "fill": "none",
            "stroke": "#3b7bbf",
            "width": 3,
            "size": 6,
            "name": "Lakes"
          },
          {
            "from": "lakes:Passed",
            "fill": "#7fb2e5",
            "stroke": "#3b7bbf",
            "width": 1.5,
            "size": 6,
            "name": "Lakes"
          }
        ]
      },
      "comment": "Water as a map"
    },
    {
      "id": "shade",
      "type": "TerrainShader",
      "x": 700,
      "y": 20,
      "params": {
        "exaggeration": "2",
        "haze": "35"
      },
      "comment": "Shaded relief"
    },
    {
      "id": "view",
      "type": "TerrainRenderer",
      "x": 700,
      "y": 240,
      "params": {
        "exaggeration": "2.5",
        "sun_altitude": "25",
        "width": "1600",
        "height": "900"
      },
      "comment": "3D view from the south-west"
    },
    {
      "id": "out_shade",
      "type": "Writer",
      "x": 940,
      "y": 20,
      "params": {
        "path": "out/relief.tif"
      },
      "comment": "Relief as GeoTIFF"
    },
    {
      "id": "out_view",
      "type": "Writer",
      "x": 940,
      "y": 240,
      "params": {
        "path": "out/terrain_3d.png"
      },
      "comment": "3D view as PNG"
    },
    {
      "id": "contours",
      "type": "ContourGenerator",
      "x": 240,
      "y": 20,
      "params": {
        "interval": "10"
      },
      "comment": "Contours every 10 m"
    },
    {
      "id": "out_contours",
      "type": "Writer",
      "x": 460,
      "y": 20,
      "params": {
        "path": "out/contours.gpkg"
      },
      "comment": "Contours"
    }
  ],
  "edges": [
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "shade",
        "Heights"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "view",
        "Heights"
      ]
    },
    {
      "from": [
        "water",
        "Output"
      ],
      "to": [
        "lakes",
        "Input"
      ]
    },
    {
      "from": [
        "lakes",
        "Passed"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "lakes",
        "Failed"
      ],
      "to": [
        "map",
        "Layers"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "shade",
        "Map"
      ]
    },
    {
      "from": [
        "map",
        "Map"
      ],
      "to": [
        "view",
        "Map"
      ]
    },
    {
      "from": [
        "shade",
        "Image"
      ],
      "to": [
        "out_shade",
        "Input"
      ]
    },
    {
      "from": [
        "view",
        "Image"
      ],
      "to": [
        "out_view",
        "Input"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "contours",
        "Heights"
      ]
    },
    {
      "from": [
        "contours",
        "Contours"
      ],
      "to": [
        "out_contours",
        "Input"
      ]
    }
  ]
}
