{
  "format": "ographis/1",
  "name": "Lines, areas and hulls",
  "nodes": [
    {
      "id": "routes",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "routes.shp"
      },
      "comment": "Routes"
    },
    {
      "id": "areas",
      "type": "Reader",
      "x": 20,
      "y": 200,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 380,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "routes_sweref",
      "type": "Reprojector",
      "x": 260,
      "y": 20,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Routes to SWEREF"
    },
    {
      "id": "towns_sweref",
      "type": "Reprojector",
      "x": 260,
      "y": 380,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Towns to SWEREF"
    },
    {
      "id": "cut",
      "type": "Intersector",
      "x": 500,
      "y": 20,
      "comment": "Routes cut by subregion. Each route in pieces, one in each subregion it runs through",
      "params": {
        "attributes": "subregion"
      }
    },
    {
      "id": "length",
      "type": "LengthCalculator",
      "x": 740,
      "y": 20,
      "params": {},
      "comment": "Length of each piece"
    },
    {
      "id": "km",
      "type": "StatisticsCalculator",
      "x": 980,
      "y": 20,
      "params": {
        "attributes": "_length",
        "group_by": "subregion"
      },
      "comment": "Route length per subregion"
    },
    {
      "id": "crossing",
      "type": "SpatialJoiner",
      "x": 500,
      "y": 200,
      "params": {
        "relation": "intersects",
        "mode": "summary",
        "count": "routes",
        "attributes": "name"
      },
      "comment": "Which routes cross each subregion"
    },
    {
      "id": "where",
      "type": "SpatialJoiner",
      "x": 500,
      "y": 380,
      "params": {
        "relation": "within",
        "attributes": "subregion"
      },
      "comment": "The subregion of each town"
    },
    {
      "id": "hull",
      "type": "ConcaveHuller",
      "x": 740,
      "y": 380,
      "params": {
        "group_by": "subregion",
        "concavity": "2"
      },
      "comment": "The spread of the towns"
    },
    {
      "id": "convex",
      "type": "ConvexHuller",
      "x": 740,
      "y": 520,
      "params": {},
      "comment": "All towns"
    },
    {
      "id": "segments",
      "type": "LineExploder",
      "x": 260,
      "y": 140,
      "params": {},
      "comment": "Segments of the routes"
    },
    {
      "id": "view",
      "type": "Viewer",
      "x": 1220,
      "y": 200,
      "params": {},
      "comment": "Look at it"
    }
  ],
  "edges": [
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "routes_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "towns_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "routes_sweref",
        "Reprojected"
      ],
      "to": [
        "cut",
        "Input"
      ]
    },
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "cut",
        "Overlay"
      ]
    },
    {
      "from": [
        "cut",
        "Intersection"
      ],
      "to": [
        "length",
        "Input"
      ]
    },
    {
      "from": [
        "length",
        "Output"
      ],
      "to": [
        "km",
        "Input"
      ]
    },
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "crossing",
        "Features"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "crossing",
        "Join"
      ]
    },
    {
      "from": [
        "towns_sweref",
        "Reprojected"
      ],
      "to": [
        "where",
        "Features"
      ]
    },
    {
      "from": [
        "areas",
        "Output"
      ],
      "to": [
        "where",
        "Join"
      ]
    },
    {
      "from": [
        "where",
        "Joined"
      ],
      "to": [
        "hull",
        "Input"
      ]
    },
    {
      "from": [
        "towns_sweref",
        "Reprojected"
      ],
      "to": [
        "convex",
        "Input"
      ]
    },
    {
      "from": [
        "routes",
        "Output"
      ],
      "to": [
        "segments",
        "Input"
      ]
    },
    {
      "from": [
        "cut",
        "Intersection"
      ],
      "to": [
        "view",
        "Input"
      ]
    },
    {
      "from": [
        "crossing",
        "Joined"
      ],
      "to": [
        "view",
        "Input"
      ]
    },
    {
      "from": [
        "hull",
        "Output"
      ],
      "to": [
        "view",
        "Input"
      ]
    }
  ]
}
