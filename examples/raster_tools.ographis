{
  "format": "ographis/1",
  "name": "Slopes, views and distances",
  "description": "The raster tools of 0.89 on the example terrain: slope classes as areas, what can be seen from two lookouts, the distance to water, and the mean slope around each lake.",
  "nodes": [
    {
      "id": "dem",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "terrain.tif",
        "raster_as": "grid"
      },
      "comment": "Terrain, 20 m"
    },
    {
      "id": "water",
      "type": "Reader",
      "x": 20,
      "y": 240,
      "params": {
        "path": "water.geojson"
      },
      "comment": "Water"
    },
    {
      "id": "lookouts",
      "type": "Reader",
      "x": 20,
      "y": 420,
      "params": {
        "path": "lookouts.csv",
        "x": "x",
        "y": "y",
        "crs": "EPSG:3006"
      },
      "comment": "Lookouts"
    },
    {
      "id": "slope",
      "type": "TerrainAnalyzer",
      "x": 280,
      "y": 20,
      "params": {
        "measure": "slope"
      },
      "comment": "Slope"
    },
    {
      "id": "classes",
      "type": "RasterReclassifier",
      "x": 540,
      "y": 20,
      "params": {
        "ranges": [
          [
            "",
            "5",
            "1"
          ],
          [
            "5",
            "15",
            "2"
          ],
          [
            "15",
            "",
            "3"
          ]
        ]
      },
      "comment": "Flat, sloping, steep"
    },
    {
      "id": "areas",
      "type": "RasterPolygonizer",
      "x": 800,
      "y": 20,
      "params": {
        "name": "class",
        "merge": "yes"
      },
      "comment": "Slope classes as areas"
    },
    {
      "id": "out_areas",
      "type": "Writer",
      "x": 1060,
      "y": 20,
      "params": {
        "path": "out/slope_classes.gpkg"
      },
      "comment": "Slope classes"
    },
    {
      "id": "lake_slopes",
      "type": "ZonalStatistics",
      "x": 540,
      "y": 200,
      "params": {
        "stats": "mean, max",
        "prefix": "slope_"
      },
      "comment": "Mean slope of each lake"
    },
    {
      "id": "out_lakes",
      "type": "Writer",
      "x": 800,
      "y": 200,
      "params": {
        "path": "out/lake_slopes.gpkg"
      },
      "comment": "Lakes"
    },
    {
      "id": "distance",
      "type": "DistanceRaster",
      "x": 280,
      "y": 300,
      "params": {
        "reach": "2000"
      },
      "comment": "Distance to water"
    },
    {
      "id": "out_distance",
      "type": "Writer",
      "x": 540,
      "y": 340,
      "params": {
        "path": "out/distance_to_water.tif"
      },
      "comment": "Distance raster"
    },
    {
      "id": "view",
      "type": "Viewshed",
      "x": 280,
      "y": 480,
      "params": {
        "eye": "eye",
        "radius": "4000"
      },
      "comment": "Seen from the lookouts"
    },
    {
      "id": "out_view",
      "type": "Writer",
      "x": 540,
      "y": 480,
      "params": {
        "path": "out/visible.tif"
      },
      "comment": "Visible area"
    },
    {
      "id": "heights",
      "type": "RasterSampler",
      "x": 280,
      "y": 640,
      "params": {
        "name": "height",
        "method": "bilinear"
      },
      "comment": "Height of each lookout"
    },
    {
      "id": "out_heights",
      "type": "Writer",
      "x": 540,
      "y": 640,
      "params": {
        "path": "out/lookouts.csv"
      },
      "comment": "Lookouts with heights"
    }
  ],
  "edges": [
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "slope",
        "Heights"
      ]
    },
    {
      "from": [
        "slope",
        "Raster"
      ],
      "to": [
        "classes",
        "Raster"
      ]
    },
    {
      "from": [
        "classes",
        "Raster"
      ],
      "to": [
        "areas",
        "Raster"
      ]
    },
    {
      "from": [
        "areas",
        "Areas"
      ],
      "to": [
        "out_areas",
        "Input"
      ]
    },
    {
      "from": [
        "water",
        "Output"
      ],
      "to": [
        "lake_slopes",
        "Zones"
      ]
    },
    {
      "from": [
        "slope",
        "Raster"
      ],
      "to": [
        "lake_slopes",
        "Raster"
      ]
    },
    {
      "from": [
        "lake_slopes",
        "Output"
      ],
      "to": [
        "out_lakes",
        "Input"
      ]
    },
    {
      "from": [
        "water",
        "Output"
      ],
      "to": [
        "distance",
        "Features"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "distance",
        "Like"
      ]
    },
    {
      "from": [
        "distance",
        "Raster"
      ],
      "to": [
        "out_distance",
        "Input"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "view",
        "Heights"
      ]
    },
    {
      "from": [
        "lookouts",
        "Output"
      ],
      "to": [
        "view",
        "Places"
      ]
    },
    {
      "from": [
        "view",
        "Raster"
      ],
      "to": [
        "out_view",
        "Input"
      ]
    },
    {
      "from": [
        "lookouts",
        "Output"
      ],
      "to": [
        "heights",
        "Features"
      ]
    },
    {
      "from": [
        "dem",
        "Output"
      ],
      "to": [
        "heights",
        "Raster"
      ]
    },
    {
      "from": [
        "heights",
        "Output"
      ],
      "to": [
        "out_heights",
        "Input"
      ]
    }
  ]
}
