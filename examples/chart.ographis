{
  "format": "ographis/1",
  "name": "Charts of towns and subregions",
  "nodes": [
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "pop",
      "type": "ChartDrawer",
      "x": 260,
      "y": 20,
      "params": {
        "category": "name",
        "value": "population",
        "sort": "down",
        "limit": "15",
        "title": "The largest towns",
        "subtitle": "Population of the 15 largest towns in the example data",
        "note": "Source: towns.csv in the examples",
        "highlight": [
          "Skövde",
          "Borås"
        ],
        "labels": "all",
        "html": "out/largest_towns.html"
      },
      "comment": "Population chart"
    },
    {
      "id": "pop_png",
      "type": "Writer",
      "x": 520,
      "y": 20,
      "params": {
        "path": "out/population.png"
      },
      "comment": "Population chart file"
    },
    {
      "id": "sub",
      "type": "Reader",
      "x": 20,
      "y": 200,
      "params": {
        "path": "subregions.gpkg"
      },
      "comment": "Subregions"
    },
    {
      "id": "sweref",
      "type": "Reprojector",
      "x": 240,
      "y": 200,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "To SWEREF 99 TM"
    },
    {
      "id": "area",
      "type": "AttributeCreator",
      "x": 460,
      "y": 200,
      "params": {
        "name": "area_km2",
        "expression": "$area / 1000000"
      },
      "comment": "Area in km²"
    },
    {
      "id": "sub_chart",
      "type": "ChartDrawer",
      "x": 680,
      "y": 200,
      "params": {
        "category": "subregion",
        "value": "area_km2",
        "sort": "name",
        "unit": "km²",
        "title": "The subregions by area",
        "subtitle": "Area of the outlines in the example data, in km²",
        "mean": "yes",
        "width": "900",
        "html": "out/subregions.html"
      },
      "comment": "Area chart"
    },
    {
      "id": "sub_png",
      "type": "Writer",
      "x": 920,
      "y": 200,
      "params": {
        "path": "out/subregions.png"
      },
      "comment": "Area chart file"
    },
    {
      "id": "slides",
      "type": "SlideWriter",
      "x": 1180,
      "y": 20,
      "comment": "Both charts as slides for PowerPoint, after a first slide with a title",
      "params": {
        "path": "out/charts.pptx",
        "format": "pptx",
        "cover": "Västra Götaland i siffror",
        "cover_note": "Exempeldata från Ographis"
      }
    }
  ],
  "edges": [
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "pop",
        "Input"
      ]
    },
    {
      "from": [
        "pop",
        "Chart"
      ],
      "to": [
        "pop_png",
        "Input"
      ]
    },
    {
      "from": [
        "sub",
        "Output"
      ],
      "to": [
        "sweref",
        "Input"
      ]
    },
    {
      "from": [
        "sweref",
        "Reprojected"
      ],
      "to": [
        "area",
        "Input"
      ]
    },
    {
      "from": [
        "area",
        "Output"
      ],
      "to": [
        "sub_chart",
        "Input"
      ]
    },
    {
      "from": [
        "sub_chart",
        "Chart"
      ],
      "to": [
        "sub_png",
        "Input"
      ]
    },
    {
      "from": [
        "pop",
        "Chart"
      ],
      "to": [
        "slides",
        "Pictures"
      ]
    },
    {
      "from": [
        "sub_chart",
        "Chart"
      ],
      "to": [
        "slides",
        "Pictures"
      ]
    }
  ]
}
