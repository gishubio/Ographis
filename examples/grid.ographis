{
  "format": "ographis/1",
  "name": "Towns in 10 km squares of a height raster",
  "nodes": [
    {
      "id": "heights",
      "type": "Reader",
      "x": 20,
      "y": 200,
      "comment": "Heights. A made-up GeoTIFF with 10 km cells, read as one square per cell",
      "params": {
        "path": "heights.tif",
        "raster_as": "cells"
      }
    },
    {
      "id": "towns",
      "type": "Reader",
      "x": 20,
      "y": 20,
      "params": {
        "path": "towns.csv",
        "crs": "EPSG:4326"
      },
      "comment": "Towns"
    },
    {
      "id": "towns_sweref",
      "type": "Reprojector",
      "x": 232,
      "y": 20,
      "params": {
        "crs": "EPSG:3006"
      },
      "comment": "Towns to SWEREF"
    },
    {
      "id": "count",
      "type": "PointCounter",
      "x": 444,
      "y": 180,
      "params": {
        "name": "towns"
      },
      "comment": "Towns per square"
    },
    {
      "id": "some",
      "type": "Tester",
      "x": 656,
      "y": 180,
      "params": {
        "test": "towns > 0"
      },
      "comment": "Squares with towns"
    },
    {
      "id": "sort",
      "type": "Sorter",
      "x": 868,
      "y": 180,
      "params": {
        "sort_by": "band_1",
        "order": "descending"
      },
      "comment": "Highest first"
    },
    {
      "id": "out_gpkg",
      "type": "Writer",
      "x": 1080,
      "y": 120,
      "params": {
        "path": "out/grid.gpkg",
        "layer": "squares_with_towns"
      },
      "comment": "Squares"
    },
    {
      "id": "out_xlsx",
      "type": "Writer",
      "x": 1080,
      "y": 260,
      "params": {
        "path": "out/grid.xlsx",
        "layer": "Squares",
        "colors": "green",
        "geometry": "none"
      },
      "comment": "Squares in Excel"
    }
  ],
  "edges": [
    {
      "from": [
        "towns",
        "Output"
      ],
      "to": [
        "towns_sweref",
        "Input"
      ]
    },
    {
      "from": [
        "heights",
        "Output"
      ],
      "to": [
        "count",
        "Polygons"
      ]
    },
    {
      "from": [
        "towns_sweref",
        "Reprojected"
      ],
      "to": [
        "count",
        "Points"
      ]
    },
    {
      "from": [
        "count",
        "Polygons"
      ],
      "to": [
        "some",
        "Input"
      ]
    },
    {
      "from": [
        "some",
        "Passed"
      ],
      "to": [
        "sort",
        "Input"
      ]
    },
    {
      "from": [
        "sort",
        "Sorted"
      ],
      "to": [
        "out_gpkg",
        "Input"
      ]
    },
    {
      "from": [
        "sort",
        "Sorted"
      ],
      "to": [
        "out_xlsx",
        "Input"
      ]
    }
  ]
}
