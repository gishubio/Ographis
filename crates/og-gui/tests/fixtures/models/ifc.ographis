{
  "format": "ographis/1",
  "name": "A house from IFC on the terrain",
  "nodes": [
    { "id": "villa", "type": "Reader", "name": "Villa, IFC", "x": 20, "y": 20, "comment": "Made by tools/make_ifc_example.py. The file places itself, by IfcMapConversion in SWEREF 99 TM", "params": { "path": "house/villa.ifc" } },
    { "id": "dem", "type": "Reader", "name": "Terrain model", "x": 20, "y": 220, "params": { "path": "terrain.tif", "raster_as": "grid", "within": "rectangle", "min_x": "417900", "min_y": "6472200", "max_x": "418400", "max_y": "6472700" } },
    { "id": "windows", "type": "Tester", "name": "Windows", "x": 280, "y": 20, "params": { "test": "IfcClass = 'IfcWindow'" } },
    { "id": "list", "type": "Writer", "name": "Elements as a table", "x": 520, "y": 20, "params": { "path": "out/villa_elements.xlsx", "geometry": "none" } },
    { "id": "scene", "type": "SceneRenderer", "name": "Afternoon", "x": 280, "y": 160,
      "params": { "width": "1400", "height": "900", "view_azimuth": "200", "elevation": "18", "zoom": "100", "sun": "date", "date": "2026-08-20", "time": "15:30", "background": "sky", "quality": "16" } },
    { "id": "png", "type": "Writer", "name": "Picture", "x": 520, "y": 160, "params": { "path": "out/villa.png" } },
    { "id": "glb", "type": "Writer", "name": "As glTF", "x": 280, "y": 340, "params": { "path": "out/villa.glb" } }
  ],
  "edges": [
    { "from": ["villa", "Output"], "to": ["windows", "Input"] },
    { "from": ["villa", "Output"], "to": ["list", "Input"] },
    { "from": ["villa", "Output"], "to": ["scene", "Models"] },
    { "from": ["dem", "Output"], "to": ["scene", "Terrain"] },
    { "from": ["scene", "Image"], "to": ["png", "Input"] },
    { "from": ["villa", "Output"], "to": ["glb", "Input"] }
  ]
}
