{
  "format": "ographis/1",
  "name": "Towns in 10 km squares of a height raster",
  "nodes": [
    { "id": "heights", "type": "Reader", "name": "Heights", "x": 20, "y": 200, "comment": "A made-up GeoTIFF with 10 km cells, read as one square per cell", "params": { "path": "heights.tif", "raster_as": "cells" } },
    { "id": "towns", "type": "Reader", "name": "Towns", "x": 20, "y": 20, "params": { "path": "towns.csv", "crs": "EPSG:4326" } },
    { "id": "towns_sweref", "type": "Reprojector", "name": "Towns to SWEREF", "x": 232, "y": 20, "params": { "crs": "EPSG:3006" } },
    { "id": "count", "type": "PointCounter", "name": "Towns per square", "x": 444, "y": 180, "params": { "name": "towns" } },
    { "id": "some", "type": "Tester", "name": "Squares with towns", "x": 656, "y": 180, "params": { "test": "towns > 0" } },
    { "id": "sort", "type": "Sorter", "name": "Highest first", "x": 868, "y": 180, "params": { "sort_by": "band_1", "order": "descending" } },
    { "id": "out_gpkg", "type": "Writer", "name": "Squares", "x": 1080, "y": 120, "params": { "path": "out/grid.gpkg", "layer": "squares_with_towns" } },
    { "id": "out_xlsx", "type": "Writer", "name": "Squares in Excel", "x": 1080, "y": 260, "params": { "path": "out/grid.xlsx", "layer": "Squares", "colors": "green", "geometry": "none" } }
  ],
  "edges": [
    { "from": ["towns", "Output"], "to": ["towns_sweref", "Input"] },
    { "from": ["heights", "Output"], "to": ["count", "Polygons"] },
    { "from": ["towns_sweref", "Reprojected"], "to": ["count", "Points"] },
    { "from": ["count", "Polygons"], "to": ["some", "Input"] },
    { "from": ["some", "Passed"], "to": ["sort", "Input"] },
    { "from": ["sort", "Sorted"], "to": ["out_gpkg", "Input"] },
    { "from": ["sort", "Sorted"], "to": ["out_xlsx", "Input"] }
  ]
}
