# Text files are kept with LF in the repository; Windows scripts are checked out with CRLF.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Data in the examples and tests, kept as it is.
*.tif binary
*.gpkg binary
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.shp binary
*.shx binary
*.dbf binary
*.parquet binary
*.glb binary
*.laz binary
*.ifc -text
